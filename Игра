  coinsOnMap = []; pickupsOnMap = []; sharks = []; creatures = []; boats = []; floorDecor = [];
  caves = []; caveJellyfish = [];
  bubbles.length = 0; particles.length = 0; floatTexts.length = 0;
  if (DOM.damageOverlay) DOM.damageOverlay.style.opacity = '0';
  if (DOM.dangerIndicator) { DOM.dangerIndicator.style.opacity = '0'; DOM.dangerIndicator.classList.remove('active'); }
  if (DOM.finishInfo) DOM.finishInfo.style.display = 'none';
  DOM.caveIndicator.classList.remove('visible');
  rewardClaimed = false;
  dayNightTimer = 0;
  isNight = false;
  nightTransition = 0;
  nightVisitRecorded = false;
}

function instantToMenu() {
  resetGameState();
  gameState = STATE.MENU;
  ['pause-screen','death-screen'].forEach(id => {
    const el = document.getElementById(id);
    if (el) { el.classList.remove('show'); el.style.display = 'none'; }
  });
  document.getElementById('menu').classList.add('show');
  hideHUD();
  buildSuitCards(); buildLocationButtons(); buildDistanceButtons();
  buildShop(); buildRewardsInfo(); updateMenuCoins(); updateHomeTab();
  buildSwimmersGrid(); buildStylesGrid();
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelector('.tab-btn[data-tab="home"]')?.classList.add('active');
  document.querySelector('.tab-panel[data-panel="home"]')?.classList.add('active');
}

function startGame() {
  resetGameState();
  const loc = LOCATIONS[selectedLocation];
  WORLD.floorY = WORLD.surfaceY + loc.depth;
  player.x = 100; player.y = WORLD.surfaceY + 100;
  player.vx = 0; player.vy = 0; player.angle = 0;
  currentDistance = 0;
  finishX = 100 + selectedDistance * PIXELS_PER_METER;
  worldWidth = finishX + 500;
  stats.startTime = performance.now();
  stats.time = 0; stats.maxDepth = 0; stats.maxSpeed = 0;
  coinsCollected = 0; sharkBites = 0; whaleAttacks = 0;
  generateItems();
  document.getElementById('menu').classList.remove('show');
  document.getElementById('death-screen').classList.remove('show');
  document.getElementById('death-screen').style.display = '';
  document.getElementById('pause-screen').classList.remove('show');
  showHUD();
  DOM.coinCount.textContent = saveData.coins;
  updateDistanceUI(); updateBuffsPanel(); updateTimerUI(0);
  gameState = STATE.PLAYING;
}

function pauseGame() {
  if (gameState !== STATE.PLAYING) return;
  gameState = STATE.PAUSED;
  input.joyX = 0; input.joyY = 0;
  input.boost = false; input.up = false; input.down = false;
  if (knob) knob.style.transform = 'translate(0, 0)';
  document.querySelectorAll('.btn').forEach(b => b.classList.remove('active'));
  document.getElementById('pause-screen').classList.add('show');
}
function resumeGame() {
  if (gameState !== STATE.PAUSED) return;
  stats.startTime = performance.now() - stats.time * 1000;
  document.getElementById('pause-screen').classList.remove('show');
  gameState = STATE.PLAYING;
}

function updateDistanceUI() {
  const meters = Math.floor(currentDistance);
  const total = selectedDistance;
  const remaining = Math.max(0, total - meters);
  DOM.distanceText.textContent = `${meters} / ${total} м`;
  DOM.distanceProgress.style.width = Math.min(100, (meters / total) * 100) + '%';
  DOM.distanceRemaining.textContent = `Осталось: ${remaining} м`;
}

function updateTimerUI(timeSec) {
  DOM.timerValue.textContent = formatTimeMS(timeSec);
  const r = getReward(selectedDistance, timeSec);
  const loc = LOCATIONS[selectedLocation];
  const locMult = 1 + loc.sharkCount * 0.05;
  const reward = Math.floor(r.reward * locMult);
  DOM.previewReward.textContent = `+${reward}`;
  DOM.rewardPreview.querySelector('.medal-icon').textContent = r.medal;
  const colors = ['#ffd700','#c0c0c0','#cd7f32','#9ca3af','#6b7280'];
  DOM.rewardPreview.style.color = colors[r.tier] || '#fff';
}

function applyBuff(type) {
  const def = ITEM_TYPES[type];
  if (!def) return;
  if (def.instant) {
    // АНТИДОТ — мгновенный эффект
    if (type === 'antidote') {
      player.poison = 0;
      player.poisonTime = 0;
      DOM.poisonBar.classList.remove('visible');
      DOM.poisonLabel.style.display = 'none';
      DOM.poisonIndicator.classList.remove('visible');
      DOM.poisonOverlay.style.opacity = '0';
      addFloatText(player.x, player.y - 40, '💊 ИСЦЕЛЁН!', '#4ade80');
      for (let k = 0; k < 15; k++) spawnParticle(player.x, player.y, 
        (Math.random()-0.5)*150, (Math.random()-0.5)*150, 'rgba(74,222,128,', 1.5);
    }
    return;
  }
  if (activeBuffs[type]) activeBuffs[type].timeLeft = Math.max(activeBuffs[type].timeLeft, def.duration);
  else activeBuffs[type] = { timeLeft: def.duration };
  if (def.shield) {
    player.shield = player.maxShield;
    DOM.shieldBar.classList.add('visible');
    DOM.shieldLabel.style.display = 'block';
  }
  if (saveData.settings.effects) {
    const flash = document.createElement('div');
    flash.style.cssText = `position:fixed;inset:0;pointer-events:none;z-index:45;background:radial-gradient(circle, ${def.glow} 0%, transparent 70%);opacity:0.8;transition:opacity 0.5s;`;
    document.body.appendChild(flash);
    requestAnimationFrame(() => flash.style.opacity = '0');
    setTimeout(() => flash.remove(), 500);
  }
  addFloatText(player.x, player.y - 40, `${def.icon} ${def.name}!`, def.color);
  updateBuffsPanel();
}

function updateBuffsPanel() {
  const keys = Object.keys(activeBuffs);
  if (keys.length === 0) { DOM.buffsPanel.innerHTML = ''; return; }
  DOM.buffsPanel.innerHTML = keys.map(id => {
    const def = ITEM_TYPES[id];
    const b = activeBuffs[id];
    return `<div class="buff-chip ${id}"><span class="icon">${def.icon}</span><span class="time">${Math.ceil(b.timeLeft)}с</span></div>`;
  }).join('');
}

let buffPanelTimer = 0;
function updateBuffs(dt) {
  let changed = false;
  Object.keys(activeBuffs).forEach(id => {
    activeBuffs[id].timeLeft -= dt;
    if (activeBuffs[id].timeLeft <= 0) {
      delete activeBuffs[id];
      if (id === 'shield') {
        player.shield = 0;
        DOM.shieldBar.classList.remove('visible');
        DOM.shieldLabel.style.display = 'none';
      }
      changed = true;
    }
  });
  buffPanelTimer -= dt;
  if (changed || buffPanelTimer <= 0) { updateBuffsPanel(); buffPanelTimer = 0.2; }
}

function getSuit() { return SUITS[selectedSuit] || SUITS.classic; }
function getSwimmer() { return SWIMMERS[selectedSwimmer] || SWIMMERS.you; }
function getStyle() { return SWIM_STYLES[selectedStyle] || SWIM_STYLES.crawl; }
function getSpeedMult() {
  let m = player.baseSpeedMult * getSuit().speedMult * getSwimmerSpeedMult(selectedSwimmer) * getStyle().speedMult;
  for (const id in activeBuffs) {
    const def = ITEM_TYPES[id];
    if (def.speedMult) m *= def.speedMult;
  }
  return m;
}
function getForceMult() {
  let m = player.baseForceMult * getSuit().forceMult * getSwimmerForceMult(selectedSwimmer);
  for (const id in activeBuffs) {
    const def = ITEM_TYPES[id];
    if (def.forceMult) m *= def.forceMult;
  }
  return m;
}
function getCoinMagnet() {
  let m = player.coinMagnet;
  for (const id in activeBuffs) {
    const def = ITEM_TYPES[id];
    if (def.coinMagnet) m += def.coinMagnet;
  }
  return m;
}
function hasShield() { return activeBuffs.shield !== undefined && player.shield > 0; }

function updatePlayer(dt, time) {
  if (!player.alive) return;
  const surfaceY = waveY(player.x, time);
  const inWater = player.y > surfaceY;
  const submerged = player.y > surfaceY + 20;
  if (player.invulnerable > 0) player.invulnerable -= dt;

  const nowInCave = checkInCave();
  if (nowInCave) {
    DOM.caveIndicator.classList.add('visible');
    DOM.caveText.textContent = `ПЕЩЕРА МЕДУЗ #${player.caveId + 1} — ДЫХАНИЕ ∞`;
  } else {
    DOM.caveIndicator.classList.remove('visible');
  }

  // Отравление — тикающий урон
  updatePoison(dt);

  let inputAngle = 0, inputMag = 0;
  const joyMag = Math.hypot(input.joyX, input.joyY);
  if (joyMag > 0.15) { inputAngle = Math.atan2(input.joyY, input.joyX); inputMag = Math.min(1, joyMag); }
  let kx = 0, ky = 0;
  if (keys['KeyA'] || keys['ArrowLeft']) kx -= 1;
  if (keys['KeyD'] || keys['ArrowRight']) kx += 1;
  if (keys['KeyW'] || keys['ArrowUp']) ky -= 1;
  if (keys['KeyS'] || keys['ArrowDown']) ky += 1;
  if (kx !== 0 || ky !== 0) { inputAngle = Math.atan2(ky, kx); inputMag = Math.min(1, Math.hypot(kx, ky)); }
  if (inputMag > 0.15) {
    let diff = inputAngle - player.angle;
    while (diff > Math.PI) diff -= Math.PI * 2;
    while (diff < -Math.PI) diff += Math.PI * 2;
    player.angle += diff * Math.min(1, dt * 8);
  }

  const boosting = input.boost || keys['Space'];
  const weakness = player.health < 30 ? 0.5 + player.health / 60 : 1;
  const stamina = getSwimmerStaminaMult(selectedSwimmer);
  const poisonSlow = player.poisonTime > 0 ? 0.7 : 1; // Отравление замедляет
  const accel = (boosting ? 900 : 400) * weakness * getForceMult() * stamina * poisonSlow;

  if (inWater && inputMag > 0.15) {
    player.vx += Math.cos(player.angle) * accel * inputMag * dt;
    player.vy += Math.sin(player.angle) * accel * inputMag * dt;
  }

  if (inWater) {
    const speed = Math.hypot(player.vx, player.vy);
    player.strokePhase += dt * (2 + speed * 0.02);
    player.legPhase += dt * (3 + speed * 0.03);
    player.breathPhase += dt * 1.2;
    const drag = submerged ? 2.5 : 1.2;
    player.vx *= Math.pow(0.5, dt * drag);
    player.vy *= Math.pow(0.5, dt * drag);
    const depthBelow = player.y - surfaceY;
    if (depthBelow > 0) {
      const buoyancy = Math.min(1, depthBelow / 200);
      player.vy -= buoyancy * 60 * dt;
    }
    player.vy += 30 * dt;
    if (input.down) player.vy += 250 * dt;
    if (input.up) player.vy -= 200 * dt;
    player.bubbleTimer -= dt;
    if (player.bubbleTimer <= 0 && (speed > 20 || input.down)) {
      spawnBubble(player.x + Math.cos(player.angle + Math.PI) * 15, player.y + Math.sin(player.angle + Math.PI) * 15);
      player.bubbleTimer = 0.15 + Math.random() * 0.2;
    }
    if (speed > 100 && Math.random() < 0.3) {
      spawnParticle(player.x - Math.cos(player.angle) * 20, player.y - Math.sin(player.angle) * 20,
        -player.vx * 0.3 + (Math.random() - 0.5) * 30, -player.vy * 0.3 + (Math.random() - 0.5) * 30);
    }
  } else {
    player.vy += 800 * dt;
    player.vx *= Math.pow(0.5, dt * 0.5);
  }

  const maxSpeed = 350 * getSpeedMult();
  const sp = Math.hypot(player.vx, player.vy);
  if (sp > maxSpeed) { player.vx = player.vx / sp * maxSpeed; player.vy = player.vy / sp * maxSpeed; }

  player.x += player.vx * dt;
  player.y += player.vy * dt;
  player.x = Math.max(50, Math.min(worldWidth - 50, player.x));
  player.y = Math.max(0, Math.min(WORLD.floorY - 20, player.y));

  currentDistance = Math.max(0, (player.x - 100) / PIXELS_PER_METER);
  if (player.x >= finishX && gameState === STATE.PLAYING) { winGame(); return; }

  if (nowInCave) {
    player.oxygen = Math.min(player.maxOxygen, player.oxygen + 50 * dt);
  } else {
    const oxyRate = 12 * getStyle().oxygenMult;
    if (submerged) {
      player.oxygen -= oxyRate * dt;
      if (player.oxygen < 0) player.oxygen = 0;
    } else {
      player.oxygen = Math.min(player.maxOxygen, player.oxygen + 30 * dt);
    }
  }

  if (player.oxygen <= 0 && submerged && !nowInCave) {
    player.health -= 15 * dt;
    if (Math.random() < 0.3) {
      spawnParticle(player.x + (Math.random()-0.5)*30, player.y + (Math.random()-0.5)*30,
        (Math.random()-0.5)*60, -30-Math.random()*40, 'rgba(255,80,80,');
    }
    DOM.damageOverlay.style.opacity = Math.min(1, (1 - player.health / 100) * 1.2);
    if (player.health <= 0) { player.health = 0; die('кислород'); }
  } else {
    if ((!submerged || nowInCave) && player.health < player.maxHealth && player.poisonTime <= 0) {
      player.health = Math.min(player.maxHealth, player.health + 8 * dt);
    }
    DOM.damageOverlay.style.opacity = player.health < 30 ? Math.min(0.6, (1 - player.health/30) * 0.6) : 0;
  }

  const depth = Math.max(0, (player.y - surfaceY) / PIXELS_PER_METER);
  if (depth > stats.maxDepth) stats.maxDepth = depth;
  if (sp > stats.maxSpeed) stats.maxSpeed = sp;

  DOM.oxygenFill.style.width = (player.oxygen / player.maxOxygen * 100) + '%';
  DOM.healthFill.style.width = (player.health / player.maxHealth * 100) + '%';
  if (player.shield > 0) DOM.shieldFill.style.width = (player.shield / player.maxShield * 100) + '%';
  DOM.speed.textContent = (sp / 10).toFixed(1);
  DOM.depth.textContent = depth.toFixed(1);

  updateDistanceUI();
  const distToFinish = (finishX - player.x) / PIXELS_PER_METER;
  const shouldShowFinish = distToFinish < 50 && distToFinish > 0;
  if (shouldShowFinish !== (DOM.finishInfo.style.display === 'block')) {
    DOM.finishInfo.style.display = shouldShowFinish ? 'block' : 'none';
  }
  updateBuffs(dt);
}

const SHARK_ACTIVE_RANGE = 900;
function updateSharks(dt) {
  let nearestDist = Infinity;
  const suit = getSuit();
  const scareMult = suit.sharkScare ? 0.5 : 1;
  for (const sh of sharks) {
    const dx = player.x - sh.x, dy = player.y - sh.y;
    const distSq = dx * dx + dy * dy;
    if (distSq > SHARK_ACTIVE_RANGE * SHARK_ACTIVE_RANGE) { sh.active = false; continue; }
    sh.active = true;
    if (sh.attackCooldown > 0) sh.attackCooldown -= dt;
    const dist = Math.sqrt(distSq);
    if (dist < nearestDist) nearestDist = dist;
    sh.stateTimer -= dt;

    if (sh.state === 'patrol') {
      if (dist < sh.def.aggroRange * scareMult && player.alive && !hasShield() && !player.inCave) { sh.state = 'chase'; sh.stateTimer = 5; }
      else {
        const angleToCenter = Math.atan2(sh.patrolCenterY - sh.y, sh.patrolCenterX - sh.x);
        sh.targetAngle = angleToCenter + Math.PI / 2;
      }
    } else if (sh.state === 'chase') {
      sh.targetAngle = Math.atan2(dy, dx);
      if (dist > sh.def.aggroRange * 1.8 || !player.alive || hasShield() || player.inCave) { sh.state = 'patrol'; sh.stateTimer = 3; }
      if (dist < sh.def.size + player.size + 5 && sh.attackCooldown <= 0 && !player.inCave) { bitePlayer(sh); sh.attackCooldown = 1.5; }
    } else if (sh.state === 'flee') {
      if (sh.stateTimer <= 0) sh.state = 'patrol';
      sh.targetAngle = Math.atan2(-dy, -dx);
    }

    let diff = sh.targetAngle - sh.angle;
    while (diff > Math.PI) diff -= Math.PI * 2;
    while (diff < -Math.PI) diff += Math.PI * 2;
    sh.angle += diff * Math.min(1, dt * 3);

    const speed = sh.state === 'chase' ? sh.def.speed : (sh.state === 'flee' ? sh.def.speed * 0.9 : sh.def.speed * 0.4);
    sh.vx = Math.cos(sh.angle) * speed; sh.vy = Math.sin(sh.angle) * speed;
    sh.x += sh.vx * dt; sh.y += sh.vy * dt;
    sh.y = Math.max(WORLD.surfaceY + 30, Math.min(WORLD.floorY - 40, sh.y));
    sh.x = Math.max(50, Math.min(worldWidth - 50, sh.x));
    sh.tailPhase += dt * (3 + speed * 0.02);
  }

  const showDanger = nearestDist < 250 && player.alive && !player.inCave;
  DOM.dangerIndicator.style.opacity = showDanger ? (1 - nearestDist / 250) * 0.8 : 0;
  if (showDanger) DOM.dangerIndicator.classList.add('active');
  else DOM.dangerIndicator.classList.remove('active');
}

function bitePlayer(shark) {
  if (player.invulnerable > 0) return;
  sharkBites++;
  player.invulnerable = 1.2;
  if (hasShield()) {
    player.shield -= 40;
    if (player.shield <= 0) {
      player.shield = 0;
      delete activeBuffs.shield;
      DOM.shieldBar.classList.remove('visible');
      DOM.shieldLabel.style.display = 'none';
      updateBuffsPanel();
    }
    addFloatText(player.x, player.y - 50, '🛡️ Щит держит!', '#7dd3fc');
    for (let i = 0; i < 8; i++) spawnParticle(player.x, player.y, (Math.random()-0.5)*200, (Math.random()-0.5)*200, 'rgba(120,200,255,', 1);
    const dx = shark.x - player.x, dy = shark.y - player.y, d = Math.hypot(dx, dy) || 1;
    shark.x += dx / d * 80; shark.y += dy / d * 80;
    shark.state = 'flee'; shark.stateTimer = 2;
    return;
  }
  player.health -= shark.def.damage;
  addFloatText(player.x, player.y - 50, `🦈 -${shark.def.damage} HP`, '#ff3b30');
  for (let i = 0; i < 12; i++) spawnParticle(player.x, player.y, (Math.random()-0.5)*300, (Math.random()-0.5)*300, 'rgba(255,40,40,', 1.5);
  DOM.damageOverlay.style.transition = 'opacity 0.05s';
  DOM.damageOverlay.style.opacity = '1';
  setTimeout(() => { DOM.damageOverlay.style.transition = 'opacity 0.3s'; DOM.damageOverlay.style.opacity = '0'; }, 80);
  const dx = shark.x - player.x, dy = shark.y - player.y, d = Math.hypot(dx, dy) || 1;
  shark.x += dx / d * 60; shark.y += dy / d * 60;
  shark.state = 'flee'; shark.stateTimer = 1.5;
  if (player.health <= 0) { player.health = 0; die('акула'); }
}

// =====================================================
// КИТЫ АТАКУЮТ
// =====================================================
function whaleBitePlayer(whale) {
  if (player.invulnerable > 0) return;
  whaleAttacks++;
  player.invulnerable = 2;
  
  if (hasShield()) {
    player.shield -= 60;
    if (player.shield <= 0) {
      player.shield = 0;
      delete activeBuffs.shield;
      DOM.shieldBar.classList.remove('visible');
      DOM.shieldLabel.style.display = 'none';
      updateBuffsPanel();
    }
    addFloatText(player.x, player.y - 60, '🛡️ Щит держит удар кита!', '#7dd3fc');
    for (let i = 0; i < 15; i++) spawnParticle(player.x, player.y, (Math.random()-0.5)*300, (Math.random()-0.5)*300, 'rgba(120,200,255,', 1.5);
    const dx = whale.x - player.x, dy = whale.y - player.y, d = Math.hypot(dx, dy) || 1;
    whale.x += dx / d * 150; whale.y += dy / d * 150;
    whale.state = 'calm'; whale.stateTimer = 3;
    return;
  }
  
  const dmg = whale.def.damage || 50;
  player.health -= dmg;
  addFloatText(player.x, player.y - 60, `🐋 -${dmg} HP!`, whale.def.golden ? '#ffd700' : '#ff3b30');
  for (let i = 0; i < 20; i++) spawnParticle(player.x, player.y, (Math.random()-0.5)*400, (Math.random()-0.5)*400, whale.def.golden ? 'rgba(255,215,0,' : 'rgba(255,40,40,', 2);
  
  DOM.damageOverlay.style.transition = 'opacity 0.05s';
  DOM.damageOverlay.style.opacity = '1';
  setTimeout(() => { DOM.damageOverlay.style.transition = 'opacity 0.3s'; DOM.damageOverlay.style.opacity = '0'; }, 150);
  
  const dx = whale.x - player.x, dy = whale.y - player.y, d = Math.hypot(dx, dy) || 1;
  whale.x += dx / d * 100; whale.y += dy / d * 100;
  whale.state = 'calm'; whale.stateTimer = 2;
  
  if (player.health <= 0) { player.health = 0; die(whale.def.golden ? 'золотой_кит' : 'кит'); }
}

function updateCreatures(dt, time) {
  const px = player.x, py = player.y;
  const activeRange = 1200;
  for (let i = creatures.length - 1; i >= 0; i--) {
    const c = creatures[i];
    const dx = c.x - px, dy = c.y - py;
    const distSq = dx*dx + dy*dy;
    if (distSq > activeRange * activeRange) { c.active = false; continue; }
    c.active = true;
    if (c.type === 'fish') updateFish(c, dt, time, px, py, distSq);
    else if (c.type === 'whale') updateWhale(c, dt, time, px, py, distSq);
    else if (c.type === 'dolphin') updateDolphin(c, dt, time, px, py);
    else if (c.type === 'jellyfish') updateFreeJellyfish(c, dt, time, px, py, distSq);
  }
}

// Свободно плавающие медузы (не в пещерах)
function updateFreeJellyfish(j, dt, time, px, py, distSq) {
  j.phase += dt * 0.8;
  j.tailPhase += dt * 2;
  j.y += Math.sin(j.phase) * 20 * dt;
  j.x += Math.cos(j.phase * 0.7) * 15 * dt;
  
  // Свечение пульсации
  const dist = Math.sqrt(distSq);
  const size = j.def.size * (1 + Math.sin(j.tailPhase) * 0.15);
  
  // Столкновение с игроком — отравление
  if (dist < size * 0.7 + player.size && player.alive && !hasShield() && player.invulnerable <= 0) {
    player.invulnerable = 1.5;
    applyPoison(j.def.damage, j.def.poisonTime);
    
    // Отталкивание
    const dx = px - j.x, dy = py - j.y, d = dist || 1;
    player.vx += dx / d * 150;
    player.vy += dy / d * 150;
  }
  
  j.x = Math.max(50, Math.min(worldWidth - 50, j.x));
  j.y = Math.max(WORLD.surfaceY + 30, Math.min(WORLD.floorY - 30, j.y));
}

function updateFish(f, dt, time, px, py, distSq) {
  const dist = Math.sqrt(distSq);
  const def = f.def;
  const fleeRange = 180;
  if (dist < fleeRange && !def.harmless && !def.poison) {
    f.fleeing = 1.5;
    const awayAngle = Math.atan2(f.y - py, f.x - px);
    f.angle = awayAngle;
    f.vx = Math.cos(f.angle) * def.speed * 1.5;
    f.vy = Math.sin(f.angle) * def.speed * 1.5;
  } else {
    if (f.fleeing > 0) f.fleeing -= dt;
    f.phase += dt * 0.8;
    f.targetAngle = f.angle + Math.sin(f.phase) * 0.5;
    let diff = f.targetAngle - f.angle;
    while (diff > Math.PI) diff -= Math.PI * 2;
    while (diff < -Math.PI) diff += Math.PI * 2;
    f.angle += diff * Math.min(1, dt * 2);
    let speed = def.speed;
    if (def.behavior === 'swift') speed *= 1.0;
    else if (def.behavior === 'hunt') speed *= 1.2 + Math.sin(time * 2 + f.phase) * 0.3;
    else if (def.behavior === 'slow') speed *= 0.5;
    else if (def.behavior === 'drift') { f.vy += Math.sin(time * 1.5 + f.phase) * 5 * dt; f.vx += Math.cos(time + f.phase) * 3 * dt; }
    else if (def.behavior === 'floor') {
      const targetY = WORLD.floorY - 30;
      f.vy += (targetY - f.y) * 0.5 * dt;
      f.vx = Math.cos(f.angle) * speed * 0.3;
    }
    if (def.behavior !== 'drift' && def.behavior !== 'floor') {
      f.vx = Math.cos(f.angle) * speed;
      f.vy = Math.sin(f.angle) * speed;
    }
  }
  f.x += f.vx * dt; f.y += f.vy * dt;
  f.tailPhase += dt * (5 + def.speed * 0.05);
  if (f.finPhase !== undefined) f.finPhase += dt * 3;
  f.x = Math.max(50, Math.min(worldWidth - 50, f.x));
  f.y = Math.max(WORLD.surfaceY + 30, Math.min(WORLD.floorY - 30, f.y));

  // Медуза из рыб отравляет
  if (def.poison) {
    const dx = px - f.x, dy = py - f.y;
    const d = Math.hypot(dx, dy);
    if (d < def.size * 0.7 + player.size && player.alive && !hasShield() && player.invulnerable <= 0) {
      player.invulnerable = 1.5;
      applyPoison(def.damage || 10, 3);
    }
  }
}

function updateWhale(w, dt, time, px, py, distSq) {
  const def = w.def;
  w.phase += dt * 0.3;
  if (w.attackCooldown > 0) w.attackCooldown -= dt;
  if (w.stateTimer > 0) w.stateTimer -= dt;
  
  const dist = Math.sqrt(distSq);
  
  // Опасные киты атакуют
  if (def.dangerous && player.alive && !hasShield() && !player.inCave) {
    if (w.state === 'patrol' && dist < def.aggroRange) {
      w.state = 'chase';
      w.stateTimer = 8;
      // Золотой кит при первой встрече
      if (def.golden && !saveData.goldWhaleSeen) {
        saveData.goldWhaleSeen = true;
        persist();
        addFloatText(player.x, player.y - 100, '✨ ЗОЛОТОЙ КИТ! ✨', '#ffd700');
      }
    }
    
    if (w.state === 'chase') {
      // Плывёт к игроку
      w.targetAngle = Math.atan2(py - w.y, px - w.x);
      if (dist < def.size * 0.4 && w.attackCooldown <= 0) {
        whaleBitePlayer(w);
        w.attackCooldown = 3;
      }
      if (dist > def.aggroRange * 2 || w.stateTimer <= 0) {
        w.state = 'calm';
        w.stateTimer = 5;
      }
    } else {
      // Патруль по кругу
      w.targetAngle = Math.atan2(w.patrolCenterY - w.y, w.patrolCenterX - w.x) + Math.PI / 2 + Math.sin(w.phase) * 0.3;
    }
  } else {
    // Мирные киты плавают по кругу
    w.targetAngle = Math.atan2(w.patrolCenterY - w.y, w.patrolCenterX - w.x) + Math.PI / 2 + Math.sin(w.phase) * 0.3;
  }
  
  let diff = w.targetAngle - w.angle;
  while (diff > Math.PI) diff -= Math.PI * 2;
  while (diff < -Math.PI) diff += Math.PI * 2;
  w.angle += diff * Math.min(1, dt * 1.5);
  
  // Скорость: в chase — быстрее
  const speedMult = w.state === 'chase' ? 1.5 : 0.8;
  const speed = def.speed * (speedMult + Math.sin(w.phase) * 0.2);
  w.vx = Math.cos(w.angle) * speed;
  w.vy = Math.sin(w.angle) * speed;
  w.x += w.vx * dt; w.y += w.vy * dt;
  w.tailPhase += dt * (w.state === 'chase' ? 3 : 1.5);
  w.y = Math.max(WORLD.surfaceY + 100, Math.min(WORLD.floorY - 150, w.y));
  w.x = Math.max(100, Math.min(worldWidth - 100, w.x));
  w.spoutTimer -= dt;
  if (w.spoutTimer <= 0 && w.y < WORLD.surfaceY + 200) w.spoutTimer = 4 + Math.random() * 6;
}

function updateDolphin(d, dt, time, px, py) {
  const def = d.def;
  d.phase += dt * 1.5;
  const dx = px - d.x, dy = py - d.y;
  const distToPlayer = Math.hypot(dx, dy);
  if (distToPlayer < 400 && distToPlayer > 80) d.targetAngle = Math.atan2(dy, dx);
  else d.targetAngle = Math.atan2(d.patrolCenterY - d.y, d.patrolCenterX - d.x) + Math.PI / 2 + Math.sin(d.phase * 0.5) * 0.5;
  let diff = d.targetAngle - d.angle;
  while (diff > Math.PI) diff -= Math.PI * 2;
  while (diff < -Math.PI) diff += Math.PI * 2;
  d.angle += diff * Math.min(1, dt * 3);
  const speed = def.speed * 0.6;
  d.vx = Math.cos(d.angle) * speed;
  d.vy = Math.sin(d.angle) * speed;
  d.x += d.vx * dt; d.y += d.vy * dt;
  d.tailPhase += dt * 6;
  d.jumpTimer -= dt;
  if (d.jumpTimer <= 0) { d.jumpTimer = 5 + Math.random() * 10; d.vy -= 300; }
  d.x = Math.max(50, Math.min(worldWidth - 50, d.x));
  d.y = Math.max(WORLD.surfaceY - 30, Math.min(WORLD.floorY - 100, d.y));
}

function updateCaveJellyfish(dt, time) {
  for (const j of caveJellyfish) {
    j.phase += dt * 0.8;
    j.pulsePhase += dt * 2;
    j.y += Math.sin(j.phase) * 15 * dt;
    j.x += Math.cos(j.phase * 0.7) * 10 * dt;

    const dx = player.x - j.x, dy = player.y - j.y;
    const dist = Math.hypot(dx, dy);
    if (dist < j.def.size * 0.7 + player.size && player.alive && !hasShield() && player.invulnerable <= 0) {
      player.invulnerable = 1.5;
      applyPoison(j.def.damage, j.def.poisonTime);
      
      const dxp = player.x - j.x, dyp = player.y - j.y, d = dist || 1;
      player.vx += dxp / d * 120;
      player.vy += dyp / d * 120;
    }
  }
}

function updateBoats(dt) {
  for (const b of boats) {
    const dx = b.x - player.x;
    b.visible = Math.abs(dx) < W / 2 + 300;
    if (!b.visible) continue;
    b.x += b.speed * b.direction * dt;
    b.bobPhase += dt * 2;
    if (b.x > b.rangeMax) { b.x = b.rangeMax; b.direction = -1; }
    else if (b.x < b.rangeMin) { b.x = b.rangeMin; b.direction = 1; }
  }
}

function checkPickups() {
  const pRadius = player.size * 1.5;
  const magnet = getCoinMagnet();
  const px = player.x, py = player.y;
  const cullRange = 800;

  for (let i = coinsOnMap.length - 1; i >= 0; i--) {
    const c = coinsOnMap[i];
    if (c.collected) { coinsOnMap.splice(i, 1); continue; }
    const dx = c.x - px, dy = c.y - py;
    if (Math.abs(dx) > cullRange) continue;
    const distSq = dx * dx + dy * dy;
    const dist = Math.sqrt(distSq);
    if (magnet > 0 && dist < magnet && dist > 5) { c.x -= dx * 0.05; c.y -= dy * 0.05; }
    if (distSq < (pRadius + c.r) * (pRadius + c.r)) {
      coinsCollected++; saveData.coins++;
      DOM.coinCount.textContent = saveData.coins;
      addFloatText(c.x, c.y, '+1 🪙', '#ffd700');
      for (let k = 0; k < 5; k++) spawnParticle(c.x, c.y, (Math.random()-0.5)*100, (Math.random()-0.5)*100, 'rgba(255,215,0,', 1.2);
      coinsOnMap.splice(i, 1);
    }
  }
  if (coinsCollected > 0) persist();

  for (let i = pickupsOnMap.length - 1; i >= 0; i--) {
    const p = pickupsOnMap[i];
    if (p.collected) { pickupsOnMap.splice(i, 1); continue; }
    const dx = p.x - px, dy = p.y - py;
    if (Math.abs(dx) > cullRange) continue;
    const distSq = dx * dx + dy * dy;
    if (distSq < (pRadius + 18) * (pRadius + 18)) {
      applyBuff(p.type);
      const def = ITEM_TYPES[p.type];
      for (let k = 0; k < 10; k++) spawnParticle(p.x, p.y, (Math.random()-0.5)*150, (Math.random()-0.5)*150, def.glow.replace(')', ','), 1.5);
      pickupsOnMap.splice(i, 1);
    }
  }
}

