function waveY(x, time) {
  const amp = LOCATIONS[selectedLocation].waveAmp;
  return WORLD.surfaceY
    + Math.sin(x * 0.01 + time * 1.5) * amp
    + Math.sin(x * 0.023 + time * 2.3) * (amp * 0.7)
    + Math.sin(x * 0.005 + time * 0.8) * (amp * 1.3);
}

function checkInCave() {
  if (!saveData.settings.caves) return false;
  for (const cave of caves) {
    const dx = player.x - cave.x;
    const dy = player.y - cave.y;
    if (Math.abs(dx) < cave.w * 0.5 && Math.abs(dy) < cave.h * 0.5) {
      if (!player.inCave) {
        player.inCave = true;
        player.caveId = cave.id;
        saveData.caveVisits = (saveData.caveVisits || 0) + 1;
        persist();
        addFloatText(player.x, player.y - 60, '🕳️ ПЕЩЕРА МЕДУЗ!', '#b464ff');
      }
      return true;
    }
  }
  if (player.inCave) {
    player.inCave = false;
    player.caveId = -1;
  }
  return false;
}

