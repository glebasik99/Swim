let bgGradCache = null, bgGradKey = '';
function drawUnderwater() {
  const loc = LOCATIONS[selectedLocation];
  const camY = player.y - H / 2;
  const depthFactor = Math.max(0, Math.min(1, camY / loc.depth));
  const daylight = 1 - nightTransition * 0.65;
  const tint = nightTransition * 0.3;

  // Отравление — фиолетовый оттенок
  const poisonShift = player.poisonTime > 0 ? Math.min(0.3, player.poisonTime * 0.1) : 0;

  const r = Math.round((loc.waterColor.r + (loc.waterDeep.r - loc.waterColor.r) * depthFactor) * daylight + poisonShift * 60);
  const g = Math.round((loc.waterColor.g + (loc.waterDeep.g - loc.waterColor.g) * depthFactor) * daylight);
  const b = Math.round((loc.waterColor.b + (loc.waterDeep.b - loc.waterColor.b) * depthFactor) * (daylight + tint) + poisonShift * 80);

  const key = `${r},${g},${b}`;
  if (bgGradKey !== key) {
    bgGradCache = ctx.createLinearGradient(0, 0, 0, H);
    bgGradCache.addColorStop(0, `rgb(${r},${g},${b})`);
    bgGradCache.addColorStop(1, `rgb(${Math.max(2,r-15)},${Math.max(8,g-20)},${Math.max(40,b-30)})`);
    bgGradKey = key;
  }
  ctx.fillStyle = bgGradCache;
  ctx.fillRect(0, 0, W, H);

  if (player.inCave) {
    ctx.fillStyle = 'rgba(120, 60, 200, 0.15)';
    ctx.fillRect(0, 0, W, H);
  }

  if (camY < 400 && !player.inCave) {
    ctx.save();
    ctx.globalAlpha = isNight ? 0.05 : 0.08;
    const lightColor = isNight ? '#a0c8ff' : '#aee6ff';
    for (let i = 0; i < 6; i++) {
      const lx = ((i * 200) + time_global * 20) % (W + 400) - 200;
      ctx.fillStyle = lightColor;
      ctx.beginPath();
      ctx.moveTo(lx, 0);
      ctx.lineTo(lx + 80, 0);
      ctx.lineTo(lx + 200, H);
      ctx.lineTo(lx - 60, H);
      ctx.closePath();
      ctx.fill();
    }
    ctx.restore();
  }
}

function drawSurface(time, camX, camY) {
  const sy = waveY(0, time) - camY;
  ctx.beginPath();
  ctx.moveTo(-10, sy + 200);
  for (let x = -10; x <= W + 10; x += 16) {
    const y = waveY(x + camX, time) - camY;
    ctx.lineTo(x, y);
  }
  ctx.lineTo(W + 10, sy + 400);
  ctx.lineTo(-10, sy + 400);
  ctx.closePath();
  const daySurface = 'rgba(60, 150, 220, 0.85)';
  const nightSurface = 'rgba(20, 50, 100, 0.9)';
  ctx.fillStyle = isNight ? nightSurface : daySurface;
  ctx.fill();
  ctx.strokeStyle = isNight ? 'rgba(150, 190, 255, 0.6)' : 'rgba(220, 245, 255, 0.7)';
  ctx.lineWidth = 2;
  ctx.beginPath();
  for (let x = -10; x <= W + 10; x += 16) {
    const y = waveY(x + camX, time) - camY;
    if (x === -10) ctx.moveTo(x, y);
    else ctx.lineTo(x, y);
  }
  ctx.stroke();

  if (isNight && nightTransition > 0.5) {
    ctx.save();
    ctx.globalAlpha = nightTransition * 0.6;
    for (let i = 0; i < 15; i++) {
      const sx = (i * 137) % W;
      const starY = sy - 10 - (i * 7 % 20);
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(sx, starY, 1.5, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
  }
}

function drawCaves(camX, camY, time) {
  if (!saveData.settings.caves) return;
  for (const cave of caves) {
    const cx = cave.x - camX;
    const cy = cave.y - camY;
    if (cx < -cave.w || cx > W + cave.w) continue;

    const caveGrad = ctx.createRadialGradient(cx, cy, 20, cx, cy, cave.w * 0.6);
    caveGrad.addColorStop(0, 'rgba(30, 10, 60, 0.4)');
    caveGrad.addColorStop(0.7, 'rgba(60, 20, 100, 0.3)');
    caveGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = caveGrad;
    ctx.beginPath();
    ctx.ellipse(cx, cy, cave.w * 0.6, cave.h * 0.6, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.strokeStyle = 'rgba(180, 100, 255, 0.7)';
    ctx.lineWidth = 6;
    ctx.beginPath();
    ctx.ellipse(cx, cy, cave.w * 0.5, cave.h * 0.5, 0, 0, Math.PI * 2);
    ctx.stroke();

    const pulse = 0.5 + Math.sin(time * 2 + cave.id) * 0.5;
    ctx.strokeStyle = `rgba(200, 150, 255, ${0.3 + pulse * 0.4})`;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.ellipse(cx, cy, cave.w * 0.5 + 10, cave.h * 0.5 + 10, 0, 0, Math.PI * 2);
    ctx.stroke();

    const innerGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, cave.w * 0.4);
    innerGrad.addColorStop(0, `rgba(200, 150, 255, ${0.1 + pulse * 0.15})`);
    innerGrad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = innerGrad;
    ctx.beginPath();
    ctx.arc(cx, cy, cave.w * 0.4, 0, Math.PI * 2);
    ctx.fill();
  }
}

function drawCaveJellyfish(camX, camY, time) {
  if (!saveData.settings.caves) return;
  for (const j of caveJellyfish) {
    const x = j.x - camX;
    const y = j.y - camY;
    if (x < -100 || x > W + 100 || y < -100 || y > H + 100) continue;
    drawSingleJellyfish(j.def, x, y, j.pulsePhase, j.phase, time, 1);
  }
}

// Реалистичная медуза с щупальцами
function drawSingleJellyfish(def, x, y, pulsePhase, phase, time, scale) {
  const pulse = (1 + Math.sin(pulsePhase) * 0.18) * scale;
  const size = def.size * pulse;

  // Свечение
  const glowGrad = ctx.createRadialGradient(x, y, 0, x, y, size * 3.5);
  glowGrad.addColorStop(0, def.glow);
  glowGrad.addColorStop(0.5, def.glow.replace('0.7', '0.3').replace('0.8', '0.3'));
  glowGrad.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.fillStyle = glowGrad;
  ctx.beginPath();
  ctx.arc(x, y, size * 3.5, 0, Math.PI * 2);
  ctx.fill();

  // Купол — градиент
  const domeGrad = ctx.createRadialGradient(x - size * 0.3, y - size * 0.3, 0, x, y, size);
  domeGrad.addColorStop(0, 'rgba(255,255,255,0.8)');
  domeGrad.addColorStop(0.4, def.color);
  domeGrad.addColorStop(1, def.color);
  
  ctx.fillStyle = domeGrad;
  ctx.globalAlpha = 0.85;
  ctx.beginPath();
  ctx.ellipse(x, y, size, size * 0.85, 0, Math.PI, 0);
  ctx.fill();
  ctx.globalAlpha = 1;

  // Контур купола
  ctx.strokeStyle = 'rgba(255, 255, 255, 0.8)';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.ellipse(x, y, size, size * 0.85, 0, Math.PI, 0);
  ctx.stroke();

  // Внутренние прожилки (как у настоящей медузы)
  ctx.strokeStyle = 'rgba(255,255,255,0.35)';
  ctx.lineWidth = 1;
  for (let i = 0; i < 5; i++) {
    const angle = (i / 5) * Math.PI - Math.PI;
    ctx.beginPath();
    ctx.moveTo(x, y);
    ctx.lineTo(x + Math.cos(angle) * size * 0.7, y + Math.sin(angle) * size * 0.7 * 0.6);
    ctx.stroke();
  }

  // Нижний ободок (ротовые руки)
  ctx.fillStyle = def.color;
  ctx.globalAlpha = 0.6;
  ctx.beginPath();
  ctx.ellipse(x, y + size * 0.05, size * 0.9, size * 0.15, 0, 0, Math.PI);
  ctx.fill();
  ctx.globalAlpha = 1;

  // Щупальца — длинные, волнистые
  const tentacleCount = 8;
  for (let t = 0; t < tentacleCount; t++) {
    const baseX = x - size * 0.9 + t * (size * 1.8 / (tentacleCount - 1));
    const tentacleLen = size * (2.5 + Math.sin(t * 1.3) * 0.5);
    
    // Основное щупальце
    ctx.strokeStyle = def.color;
    ctx.lineWidth = 1.8;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(baseX, y + size * 0.1);
    
    const segments = 8;
    for (let seg = 1; seg <= segments; seg++) {
      const segY = y + size * 0.1 + (tentacleLen / segments) * seg;
      const waveX = baseX + Math.sin(time * 2.5 + phase + t * 0.9 + seg * 0.6) * (5 + seg * 1.2);
      ctx.lineTo(waveX, segY);
    }
    ctx.stroke();
    
    // Тонкая внутренняя линия
    ctx.strokeStyle = 'rgba(255,255,255,0.5)';
    ctx.lineWidth = 0.8;
    ctx.beginPath();
    ctx.moveTo(baseX, y + size * 0.1);
    for (let seg = 1; seg <= segments; seg++) {
      const segY = y + size * 0.1 + (tentacleLen / segments) * seg;
      const waveX = baseX + Math.sin(time * 2.5 + phase + t * 0.9 + seg * 0.6) * (5 + seg * 1.2);
      ctx.lineTo(waveX, segY);
    }
    ctx.stroke();
  }

  // Точки на куполе
  ctx.fillStyle = 'rgba(255,255,255,0.6)';
  for (let i = 0; i < 6; i++) {
    const a = (i / 6) * Math.PI - Math.PI;
    const px = x + Math.cos(a) * size * 0.5;
    const py = y + Math.sin(a) * size * 0.5 * 0.7;
    ctx.beginPath();
    ctx.arc(px, py, 1.2, 0, Math.PI * 2);
    ctx.fill();
  }
}

function drawFloor(time, camX, camY) {
  const fy = WORLD.floorY - camY;
  if (fy < -100 || fy > H + 200) return;
  const loc = LOCATIONS[selectedLocation];
  let floorColor = '#1a2a3a', floorColor2 = '#0d1a25';
  if (loc.floorType === 'sand') { floorColor = '#c9b070'; floorColor2 = '#8b7a4a'; }
  else if (loc.floorType === 'coral') { floorColor = '#3a4a5a'; floorColor2 = '#2a3540'; }
  else if (loc.floorType === 'volcanic') { floorColor = '#2a1a1a'; floorColor2 = '#0a0505'; }
  else if (loc.floorType === 'ice') { floorColor = '#a8d0e0'; floorColor2 = '#6a90a8'; }
  else if (loc.floorType === 'rock') { floorColor = '#3a3a42'; floorColor2 = '#1a1a22'; }

  const dark = 1 - nightTransition * 0.55;
  ctx.save();
  ctx.globalAlpha = dark;

  ctx.fillStyle = floorColor;
  ctx.beginPath();
  ctx.moveTo(0, H + 100);
  for (let x = -20; x <= W + 20; x += 20) {
    const worldX = x + camX;
    const h = Math.sin(worldX * 0.005) * 8 + Math.sin(worldX * 0.013) * 5;
    ctx.lineTo(x, fy + h);
  }
  ctx.lineTo(W + 20, H + 100);
  ctx.closePath();
  ctx.fill();

  ctx.restore();

  const shadowGrad = ctx.createLinearGradient(0, fy, 0, H);
  shadowGrad.addColorStop(0, 'rgba(0,0,0,0)');
  shadowGrad.addColorStop(1, 'rgba(0,0,0,0.6)');
  ctx.fillStyle = shadowGrad;
  ctx.fillRect(0, fy, W, H - fy);

  ctx.save();
  ctx.globalAlpha = dark;
  for (const d of floorDecor) {
    const dx = d.x - camX;
    if (dx < -100 || dx > W + 100) continue;
    const dh = Math.sin(d.x * 0.005) * 8 + Math.sin(d.x * 0.013) * 5;
    const dy = fy + dh;
    drawFloorDecor(d, dx, dy, time, floorColor2);
  }
  ctx.restore();
}

function drawFloorDecor(d, dx, dy, time, floorColor2) {
  ctx.save();
  if (d.type === 'rock' || d.type === 'volcanicRock' || d.type === 'iceRock') {
    ctx.fillStyle = floorColor2;
    ctx.beginPath();
    ctx.ellipse(dx, dy, d.size, d.size * 0.6, 0, Math.PI, 0);
    ctx.fill();
    ctx.fillStyle = 'rgba(255,255,255,0.08)';
    ctx.beginPath();
    ctx.ellipse(dx - d.size * 0.3, dy - d.size * 0.3, d.size * 0.3, d.size * 0.15, 0, 0, Math.PI * 2);
    ctx.fill();
  } else if (d.type === 'sandMound') {
    ctx.fillStyle = floorColor2;
    ctx.beginPath();
    ctx.ellipse(dx, dy, d.size * 1.2, d.size * 0.4, 0, Math.PI, 0);
    ctx.fill();
  } else if (d.type === 'shell') {
    ctx.fillStyle = '#ffe4c4';
    ctx.beginPath();
    ctx.arc(dx, dy - 4, d.size * 0.3, 0, Math.PI * 2);
    ctx.fill();
  } else if (d.type === 'seaweed') {
    ctx.strokeStyle = '#2d5a1e';
    ctx.lineWidth = 4;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(dx, dy);
    for (let i = 0; i < 5; i++) {
      const yy = dy - i * 15;
      const xx = dx + Math.sin(time * 1.5 + d.phase + i * 0.5) * 10;
      ctx.lineTo(xx, yy);
    }
    ctx.stroke();
  } else if (d.type === 'coral') {
    const colors = ['#ff6b1a','#ff3b70','#b464ff','#00d4c8'];
    ctx.strokeStyle = colors[Math.floor(d.seed * colors.length)];
    ctx.lineWidth = 5;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(dx, dy);
    ctx.lineTo(dx - 15, dy - 30);
    ctx.moveTo(dx, dy);
    ctx.lineTo(dx + 10, dy - 35);
    ctx.moveTo(dx, dy);
    ctx.lineTo(dx - 5, dy - 45);
    ctx.stroke();
  } else if (d.type === 'vent') {
    ctx.fillStyle = '#1a1a1a';
    ctx.fillRect(dx - 8, dy - 20, 16, 20);
    ctx.fillStyle = 'rgba(255,100,50,0.6)';
    ctx.beginPath();
    ctx.arc(dx, dy - 22, 6 + Math.sin(time * 3) * 2, 0, Math.PI * 2);
    ctx.fill();
  } else if (d.type === 'crack') {
    ctx.strokeStyle = 'rgba(0,0,0,0.4)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(dx - d.size, dy);
    ctx.lineTo(dx, dy - 4);
    ctx.lineTo(dx + d.size, dy + 2);
    ctx.stroke();
  }
  ctx.restore();
}

function drawDistanceMarkers(camX, camY) {
  const startM = Math.max(100, Math.floor((camX - 100) / PIXELS_PER_METER / 100) * 100);
  const endM = Math.min(selectedDistance, Math.ceil((camX + W) / PIXELS_PER_METER / 100) * 100);
  for (let m = startM; m <= endM; m += 100) {
    const x = 100 + m * PIXELS_PER_METER - camX;
    if (x < -50 || x > W + 50) continue;
    const isFinish = (m === selectedDistance);
    const surfaceY = waveY(100 + m * PIXELS_PER_METER, 0) - camY;
    if (isFinish) {
      ctx.fillStyle = '#ffd700';
      ctx.fillRect(x - 3, surfaceY - 250, 6, 250);
      ctx.fillRect(x + 40, surfaceY - 250, 6, 250);
      for (let fy = 0; fy < 5; fy++) for (let fx = 0; fx < 3; fx++) {
        ctx.fillStyle = (fx + fy) % 2 === 0 ? '#fff' : '#000';
        ctx.fillRect(x - 3 + fx * 15, surfaceY - 250 + fy * 15, 15, 15);
        ctx.fillRect(x + 40 + fx * 15, surfaceY - 250 + fy * 15, 15, 15);
      }
      ctx.fillStyle = '#ffd700';
      ctx.font = 'bold 22px Arial';
      ctx.textAlign = 'center';
      ctx.fillText('🏁 ФИНИШ', x + 22, surfaceY - 270);
    } else {
      const bob = Math.sin(time_global * 2 + m) * 5;
      ctx.fillStyle = m % 500 === 0 ? '#ff3b30' : '#ff9500';
      ctx.beginPath();
      ctx.arc(x, surfaceY + bob, 12, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#fff';
      ctx.font = 'bold 11px Arial';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(m, x, surfaceY + bob);
    }
  }
}

function drawCoins(time, camX, camY) {
  for (const c of coinsOnMap) {
    const x = c.x - camX;
    if (x < -60 || x > W + 60) continue;
    const y = c.y - camY;
    if (y < -60 || y > H + 60) continue;
    const bob = Math.sin(time * 2 + c.phase) * 4;
    const squash = Math.abs(Math.sin(time * 3 + c.phase));
    const radiusX = c.r * (0.3 + squash * 0.7);
    const grad = ctx.createRadialGradient(x, y + bob, 2, x, y + bob, c.r);
    grad.addColorStop(0, '#fff5b8');
    grad.addColorStop(0.6, '#ffd700');
    grad.addColorStop(1, '#c99a00');
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.ellipse(x, y + bob, radiusX, c.r, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = '#b8860b';
    ctx.lineWidth = 1.5;
    ctx.stroke();
  }
}

function drawPickups(time, camX, camY) {
  for (const p of pickupsOnMap) {
    const x = p.x - camX;
    if (x < -80 || x > W + 80) continue;
    const y = p.y - camY;
    if (y < -80 || y > H + 80) continue;
    const def = ITEM_TYPES[p.type];
    const bob = Math.sin(time * 2 + p.phase) * 6;
    const pulse = 1 + Math.sin(time * 4 + p.phase) * 0.1;
    const r = 22 * pulse;
    const auraGrad = ctx.createRadialGradient(x, y + bob, 0, x, y + bob, r * 2.5);
    auraGrad.addColorStop(0, def.glow);
    auraGrad.addColorStop(0.6, def.glow.replace('0.7','0.2').replace('0.8','0.2'));
    auraGrad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = auraGrad;
    ctx.beginPath();
    ctx.arc(x, y + bob, r * 2.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = def.color;
    ctx.beginPath();
    ctx.arc(x, y + bob, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = 'rgba(255,255,255,0.9)';
    ctx.lineWidth = 3;
    ctx.stroke();
    ctx.fillStyle = '#fff';
    ctx.font = `bold ${r * 1.2}px Arial`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(def.icon, x, y + bob + 1);
  }
}

function drawShark(sh, camX, camY) {
  if (!sh.active) return;
  const x = sh.x - camX, y = sh.y - camY;
  if (x < -200 || x > W + 200 || y < -200 || y > H + 200) return;
  const s = sh.def.size;
  const chase = sh.state === 'chase';
  const tail = Math.sin(sh.tailPhase) * 0.5;
  ctx.save();
  ctx.translate(x, y);
  ctx.rotate(sh.angle);
  const grad = ctx.createLinearGradient(0, -s * 0.5, 0, s * 0.5);
  grad.addColorStop(0, sh.def.color);
  grad.addColorStop(0.6, sh.def.finColor);
  grad.addColorStop(1, '#1a202c');
  ctx.fillStyle = grad;
  ctx.beginPath();
  ctx.ellipse(0, 0, s * 1.6, s * 0.55, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = sh.def.finColor;
  ctx.beginPath();
  ctx.moveTo(-s * 1.4, 0);
  ctx.lineTo(-s * 2.2, -s * 0.5 + tail * s * 0.3);
  ctx.lineTo(-s * 2.4, tail * s * 0.4);
  ctx.lineTo(-s * 2.2, s * 0.5 + tail * s * 0.3);
  ctx.closePath();
  ctx.fill();
  ctx.beginPath();
  ctx.moveTo(-s * 0.2, -s * 0.5);
  ctx.lineTo(s * 0.2, -s * 0.5);
  ctx.lineTo(-s * 0.1, -s * 1.2);
  ctx.closePath();
  ctx.fill();
  ctx.beginPath();
  ctx.moveTo(s * 0.2, s * 0.5);
  ctx.lineTo(s * 0.4, s * 0.5);
  ctx.lineTo(s * 0.1, s * 1.0);
  ctx.closePath();
  ctx.fill();
  ctx.fillStyle = chase ? '#ff0000' : '#000';
  ctx.beginPath();
  ctx.arc(s * 1.15, -s * 0.15, s * 0.1, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();
}

function drawCreature(c, camX, camY, time) {
  if (!c.active) return;
  const x = c.x - camX, y = c.y - camY;
  if (x < -400 || x > W + 400 || y < -400 || y > H + 400) return;
  if (c.type === 'fish') drawFish(c, x, y, time);
  else if (c.type === 'whale') drawWhale(c, x, y, time);
  else if (c.type === 'dolphin') drawDolphin(c, x, y, time);
  else if (c.type === 'jellyfish') drawSingleJellyfish(c.def, x, y, c.tailPhase, c.phase, time, 1);
}

function drawFish(f, x, y, time) {
  const def = f.def;
  const s = def.size;
  const tail = Math.sin(f.tailPhase);
  const fin = Math.sin((f.finPhase || 0) * 1.5);
  const alpha = (0.9 + Math.sin(time * 2 + f.phase) * 0.1) * (1 - nightTransition * 0.35);
  ctx.save();
  ctx.translate(x, y);
  ctx.rotate(f.angle);
  ctx.globalAlpha = alpha;

  const shape = def.bodyShape || 'oval';

  if (shape === 'jellyfish') { drawRealJellyfish(f, s, time); ctx.restore(); return; }
  if (shape === 'seahorse') { drawRealSeahorse(f, s, time); ctx.restore(); return; }
  if (shape === 'turtle' || def.shell) { drawRealTurtle(f, s, time); ctx.restore(); return; }
  if (shape === 'ray' || shape === 'manta') { drawRealRay(f, s, time, shape === 'manta'); ctx.restore(); return; }

  drawFishTail(def, s, tail, 0.6);
  drawFishPectoralFins(def, s, fin, tail);
  drawFishDorsalFin(def, s, tail);
  drawFishVentralFin(def, s, tail);
  drawFishBody(def, s, shape);
  drawFishPattern(def, s, shape);
  drawFishScales(def, s, shape);
  drawFishGills(def, s, shape);
  drawFishEye(def, s, shape);
  drawFishMouth(def, s, shape);
  if (def.spikes) drawPufferfishSpikes(def, s);

  ctx.restore();
}

function drawFishTail(def, s, tail, amp) {
  ctx.fillStyle = def.finColor || def.color;
  ctx.save();
  ctx.rotate(tail * amp * 0.5);
  const shape = def.tailShape || 'forked';
  ctx.beginPath();
  if (shape === 'crescent') {
    ctx.moveTo(-s * 0.85, 0);
    ctx.quadraticCurveTo(-s * 1.2, -s * 0.1, -s * 1.4, -s * 0.7 + tail * s * 0.15);
    ctx.quadraticCurveTo(-s * 1.15, -s * 0.25, -s * 1.1, 0);
    ctx.quadraticCurveTo(-s * 1.15, s * 0.25, -s * 1.4, s * 0.7 + tail * s * 0.15);
    ctx.quadraticCurveTo(-s * 1.2, s * 0.1, -s * 0.85, 0);
  } else if (shape === 'forked') {
    ctx.moveTo(-s * 0.85, 0);
    ctx.lineTo(-s * 1.3, -s * 0.5 + tail * s * 0.2);
    ctx.lineTo(-s * 1.05, -s * 0.1);
    ctx.lineTo(-s * 1.3, s * 0.5 + tail * s * 0.2);
    ctx.lineTo(-s * 0.85, 0);
  } else if (shape === 'fan') {
    ctx.moveTo(-s * 0.85, 0);
    ctx.quadraticCurveTo(-s * 1.5, -s * 0.7 + tail * s * 0.2, -s * 1.35, 0);
    ctx.quadraticCurveTo(-s * 1.5, s * 0.7 + tail * s * 0.2, -s * 0.85, 0);
  } else {
    ctx.moveTo(-s * 0.85, 0);
    ctx.quadraticCurveTo(-s * 1.5, -s * 0.6 + tail * s * 0.2, -s * 1.3, 0);
    ctx.quadraticCurveTo(-s * 1.5, s * 0.6 + tail * s * 0.2, -s * 0.85, 0);
  }
  ctx.closePath();
  ctx.fill();
  ctx.strokeStyle = 'rgba(0,0,0,0.25)';
  ctx.lineWidth = 1;
  for (let i = -2; i <= 2; i++) {
    if (i === 0) continue;
    ctx.beginPath();
    ctx.moveTo(-s * 0.9, 0);
    ctx.lineTo(-s * 1.25, i * s * 0.2 + tail * s * 0.15);
    ctx.stroke();
  }
  ctx.restore();
}

function drawFishPectoralFins(def, s, fin, tail) {
  ctx.fillStyle = def.finColor || def.color;
  ctx.globalAlpha *= 0.9;
  ctx.save();
  ctx.translate(s * 0.1, -s * 0.25);
  ctx.rotate(0.4 + fin * 0.15);
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.quadraticCurveTo(s * 0.2, -s * 0.2, s * 0.35, -s * 0.05);
  ctx.quadraticCurveTo(s * 0.15, s * 0.05, 0, 0);
  ctx.fill();
  ctx.restore();
  ctx.save();
  ctx.translate(s * 0.1, s * 0.25);
  ctx.rotate(-0.4 - fin * 0.15);
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.quadraticCurveTo(s * 0.2, s * 0.2, s * 0.35, s * 0.05);
  ctx.quadraticCurveTo(s * 0.15, -s * 0.05, 0, 0);
  ctx.fill();
  ctx.restore();
  ctx.globalAlpha = 1;
}

function drawFishDorsalFin(def, s, tail) {
  ctx.fillStyle = def.finColor || def.color;
  ctx.globalAlpha *= 0.85;
  ctx.beginPath();
  const shape = def.bodyShape;
  if (shape === 'disc') {
    ctx.moveTo(-s * 0.3, -s * 0.55);
    ctx.quadraticCurveTo(s * 0.1, -s * 1.1 + tail * s * 0.1, s * 0.5, -s * 0.5);
    ctx.quadraticCurveTo(s * 0.1, -s * 0.6, -s * 0.3, -s * 0.55);
  } else if (shape === 'torpedo' || shape === 'pike') {
    ctx.moveTo(-s * 0.2, -s * 0.5);
    ctx.quadraticCurveTo(0, -s * 1.0 + tail * s * 0.1, s * 0.3, -s * 0.45);
    ctx.quadraticCurveTo(0, -s * 0.5, -s * 0.2, -s * 0.5);
  } else {
    ctx.moveTo(-s * 0.3, -s * 0.5);
    ctx.quadraticCurveTo(-s * 0.05, -s * 0.95 + tail * s * 0.15, s * 0.3, -s * 0.45);
    ctx.quadraticCurveTo(0, -s * 0.5, -s * 0.3, -s * 0.5);
  }
  ctx.fill();
  ctx.globalAlpha = 1;
}

function drawFishVentralFin(def, s, tail) {
  ctx.fillStyle = def.finColor || def.color;
  ctx.globalAlpha *= 0.8;
  ctx.beginPath();
  ctx.moveTo(-s * 0.15, s * 0.5);
  ctx.quadraticCurveTo(0, s * 0.85 + tail * s * 0.1, s * 0.25, s * 0.45);
  ctx.quadraticCurveTo(0, s * 0.5, -s * 0.15, s * 0.5);
  ctx.fill();
  ctx.globalAlpha = 1;
}

function drawFishBody(def, s, shape) {
  const grad = ctx.createLinearGradient(0, -s * 0.5, 0, s * 0.5);
  grad.addColorStop(0, def.color);
  grad.addColorStop(0.55, def.color2 || def.color);
  grad.addColorStop(1, def.color);
  ctx.fillStyle = grad;
  ctx.beginPath();
  if (shape === 'disc') {
    ctx.ellipse(0, 0, s * 0.9, s * 0.75, 0, 0, Math.PI * 2);
  } else if (shape === 'torpedo') {
    ctx.moveTo(s * 1.15, 0);
    ctx.quadraticCurveTo(s * 0.5, -s * 0.55, -s * 0.6, -s * 0.4);
    ctx.quadraticCurveTo(-s * 0.95, -s * 0.15, -s * 0.9, 0);
    ctx.quadraticCurveTo(-s * 0.95, s * 0.15, -s * 0.6, s * 0.4);
    ctx.quadraticCurveTo(s * 0.5, s * 0.55, s * 1.15, 0);
  } else if (shape === 'pike') {
    ctx.moveTo(s * 1.3, 0);
    ctx.quadraticCurveTo(s * 0.7, -s * 0.4, -s * 0.4, -s * 0.3);
    ctx.quadraticCurveTo(-s * 0.85, -s * 0.15, -s * 0.85, 0);
    ctx.quadraticCurveTo(-s * 0.85, s * 0.15, -s * 0.4, s * 0.3);
    ctx.quadraticCurveTo(s * 0.7, s * 0.4, s * 1.3, 0);
  } else if (shape === 'sword') {
    ctx.moveTo(s * 1.05, -s * 0.05);
    ctx.lineTo(s * 1.6, 0);
    ctx.lineTo(s * 1.05, s * 0.05);
    ctx.quadraticCurveTo(s * 0.5, -s * 0.45, -s * 0.4, -s * 0.35);
    ctx.quadraticCurveTo(-s * 0.85, -s * 0.15, -s * 0.85, 0);
    ctx.quadraticCurveTo(-s * 0.85, s * 0.15, -s * 0.4, s * 0.35);
    ctx.quadraticCurveTo(s * 0.5, s * 0.45, s * 1.05, s * 0.05);
  } else if (shape === 'angelfish') {
    ctx.moveTo(s * 0.9, 0);
    ctx.quadraticCurveTo(s * 0.4, -s * 0.7, -s * 0.3, -s * 0.6);
    ctx.quadraticCurveTo(-s * 0.8, -s * 0.5, -s * 0.85, 0);
    ctx.quadraticCurveTo(-s * 0.8, s * 0.5, -s * 0.3, s * 0.6);
    ctx.quadraticCurveTo(s * 0.4, s * 0.7, s * 0.9, 0);
  } else if (shape === 'puffer') {
    ctx.arc(0, 0, s * 0.85, 0, Math.PI * 2);
  } else {
    ctx.ellipse(0, 0, s, s * 0.55, 0, 0, Math.PI * 2);
  }
  ctx.closePath();
  ctx.fill();
  ctx.strokeStyle = 'rgba(0,0,0,0.25)';
  ctx.lineWidth = 1.5;
  ctx.stroke();
  ctx.save();
  ctx.globalAlpha *= 0.5;
  ctx.fillStyle = 'rgba(255,255,255,0.5)';
  ctx.beginPath();
  if (shape === 'disc' || shape === 'angelfish' || shape === 'puffer') {
    ctx.ellipse(0, s * 0.25, s * 0.6, s * 0.2, 0, 0, Math.PI * 2);
  } else {
    ctx.ellipse(0, s * 0.15, s * 0.7, s * 0.15, 0, 0, Math.PI * 2);
  }
  ctx.fill();
  ctx.restore();
}

function drawFishPattern(def, s, shape) {
  if (!def.stripeColor || !def.stripeCount) return;
  ctx.save();
  ctx.globalAlpha *= 0.85;
  ctx.fillStyle = def.stripeColor;
  if (def.id === 'clownfish') {
    for (let i = 0; i < 3; i++) {
      const sx = s * 0.6 - i * s * 0.55;
      ctx.beginPath();
      ctx.ellipse(sx, 0, s * 0.09, s * 0.5, 0, 0, Math.PI * 2);
      ctx.fill();
    }
  } else if (def.id === 'blue_tang') {
    ctx.beginPath();
    ctx.moveTo(-s * 0.2, -s * 0.6);
    ctx.lineTo(s * 0.15, s * 0.6);
    ctx.lineTo(-s * 0.15, s * 0.6);
    ctx.lineTo(-s * 0.5, -s * 0.6);
    ctx.closePath();
    ctx.fill();
  } else if (def.id === 'angelfish') {
    for (let i = 0; i < 2; i++) {
      const sx = s * 0.3 - i * s * 0.5;
      ctx.beginPath();
      ctx.ellipse(sx, 0, s * 0.1, s * 0.55, 0, 0, Math.PI * 2);
      ctx.fill();
    }
  } else if (def.id === 'tuna' || def.id === 'mackerel') {
    for (let i = 0; i < def.stripeCount; i++) {
      const sy = -s * 0.2 + i * s * 0.12;
      ctx.beginPath();
      ctx.moveTo(-s * 0.5, sy);
      ctx.lineTo(s * 0.9, sy * 0.7);
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = def.stripeColor;
      ctx.stroke();
    }
  } else if (def.id === 'barracuda') {
    for (let i = 0; i < 5; i++) {
      const sx = -s * 0.4 + i * s * 0.25;
      ctx.beginPath();
      ctx.ellipse(sx, s * (i % 2 === 0 ? -0.15 : 0.1), s * 0.06, s * 0.1, 0, 0, Math.PI * 2);
      ctx.fill();
    }
  } else if (def.id === 'parrotfish') {
    for (let i = 0; i < 3; i++) {
      ctx.beginPath();
      ctx.arc(-s * 0.3 + i * s * 0.35, -s * 0.1 + (i%2)*s*0.2, s * 0.12, 0, Math.PI * 2);
      ctx.fill();
    }
  }
  ctx.restore();
}

function drawFishScales(def, s, shape) {
  ctx.save();
  ctx.globalAlpha *= 0.18;
  ctx.strokeStyle = '#ffffff';
  ctx.lineWidth = 0.8;
  const rows = 5;
  const cols = 8;
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      const sx = -s * 0.6 + c * (s * 1.2 / cols);
      const sy = -s * 0.35 + r * (s * 0.7 / rows);
      if (shape === 'disc' || shape === 'angelfish' || shape === 'puffer') {
        const dx = sx / (s * 0.8);
        const dy = sy / (s * 0.65);
        if (dx * dx + dy * dy > 1) continue;
      }
      ctx.beginPath();
      ctx.arc(sx, sy, s * 0.06, Math.PI * 1.1, Math.PI * 1.9);
      ctx.stroke();
    }
  }
  ctx.restore();
}

function drawFishGills(def, s, shape) {
  ctx.save();
  ctx.globalAlpha *= 0.5;
  ctx.strokeStyle = 'rgba(0,0,0,0.5)';
  ctx.lineWidth = 1.5;
  const gx = shape === 'sword' ? s * 0.75 : s * 0.7;
  if (shape === 'pike' || shape === 'sword') {
    for (let i = 0; i < 3; i++) {
      ctx.beginPath();
      ctx.moveTo(gx - i * 4, -s * 0.15);
      ctx.quadraticCurveTo(gx - i * 4 - 3, 0, gx - i * 4, s * 0.15);
      ctx.stroke();
    }
  } else {
    ctx.beginPath();
    ctx.arc(gx, 0, s * 0.18, Math.PI * 1.2, Math.PI * 1.8);
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(gx, 0, s * 0.13, Math.PI * 1.2, Math.PI * 1.8);
    ctx.stroke();
  }
  ctx.restore();
}

function drawFishEye(def, s, shape) {
  const ex = shape === 'pike' ? s * 0.95 : (shape === 'disc' ? s * 0.55 : s * 0.7);
  const ey = -s * 0.12;
  ctx.fillStyle = '#ffffff';
  ctx.beginPath();
  ctx.arc(ex, ey, s * 0.14, 0, Math.PI * 2);
  ctx.fill();
  let irisColor = '#1a202c';
  if (def.id === 'clownfish') irisColor = '#111827';
  else if (def.id === 'yellow_tang') irisColor = '#1e293b';
  else if (def.id === 'blue_tang') irisColor = '#0f172a';
  else if (def.id === 'tuna') irisColor = '#000000';
  else if (def.id === 'parrotfish') irisColor = '#1a202c';
  ctx.fillStyle = irisColor;
  ctx.beginPath();
  ctx.arc(ex, ey, s * 0.09, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = '#000000';
  ctx.beginPath();
  ctx.arc(ex, ey, s * 0.05, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = 'rgba(255,255,255,0.9)';
  ctx.beginPath();
  ctx.arc(ex - s * 0.03, ey - s * 0.03, s * 0.025, 0, Math.PI * 2);
  ctx.fill();
}

function drawFishMouth(def, s, shape) {
  const mx = shape === 'sword' ? s * 1.05 : (shape === 'pike' ? s * 1.25 : (shape === 'disc' ? s * 0.8 : s * 1.05));
  const my = shape === 'pike' ? -s * 0.05 : s * 0.05;
  ctx.save();
  ctx.strokeStyle = 'rgba(0,0,0,0.6)';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  if (shape === 'pike' || shape === 'sword') {
    ctx.moveTo(mx, my);
    ctx.lineTo(mx - s * 0.15, my + s * 0.08);
  } else if (shape === 'puffer') {
    ctx.arc(s * 0.75, s * 0.05, s * 0.06, -0.3, 0.3);
  } else {
    ctx.arc(mx - s * 0.1, my, s * 0.06, -0.2, 0.6);
  }
  ctx.stroke();
  ctx.restore();
}

function drawPufferfishSpikes(def, s) {
  ctx.save();
  ctx.fillStyle = 'rgba(0,0,0,0.5)';
  for (let i = 0; i < 16; i++) {
    const a = (i / 16) * Math.PI * 2;
    const sx = Math.cos(a) * s * 0.85;
    const sy = Math.sin(a) * s * 0.85;
    const ex = Math.cos(a) * s * 1.02;
    const ey = Math.sin(a) * s * 1.02;
    ctx.beginPath();
    ctx.moveTo(sx - Math.sin(a) * s * 0.04, sy + Math.cos(a) * s * 0.04);
    ctx.lineTo(ex, ey);
    ctx.lineTo(sx + Math.sin(a) * s * 0.04, sy - Math.cos(a) * s * 0.04);
    ctx.closePath();
    ctx.fill();
  }
  ctx.restore();
}

function drawRealJellyfish(f, s, time) {
  const def = f.def;
  const pulse = 1 + Math.sin(time * 2 + f.phase) * 0.15;
  const size = s * pulse;
  const glowGrad = ctx.createRadialGradient(0, 0, 0, 0, 0, size * 2.5);
  glowGrad.addColorStop(0, def.color + '80');
  glowGrad.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.fillStyle = glowGrad;
  ctx.beginPath();
  ctx.arc(0, 0, size * 2.5, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = def.color;
  ctx.globalAlpha *= 0.75;
  ctx.beginPath();
  ctx.ellipse(0, 0, size, size * 0.8, 0, Math.PI, 0);
  ctx.fill();
  ctx.globalAlpha = 1;
  ctx.strokeStyle = 'rgba(255,255,255,0.6)';
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.ellipse(0, 0, size, size * 0.8, 0, Math.PI, 0);
  ctx.stroke();
  ctx.strokeStyle = def.color;
  ctx.lineWidth = 2;
  ctx.lineCap = 'round';
  for (let t = 0; t < 6; t++) {
    const bx = -size * 0.8 + t * (size * 1.6 / 5);
    ctx.beginPath();
    ctx.moveTo(bx, 0);
    for (let seg = 1; seg <= 5; seg++) {
      const sy = seg * (size * 0.5);
      const sx = bx + Math.sin(time * 3 + f.phase + t + seg * 0.6) * 5;
      ctx.lineTo(sx, sy);
    }
    ctx.stroke();
  }
}

function drawRealSeahorse(f, s, time) {
  const def = f.def;
  ctx.fillStyle = def.color;
  ctx.strokeStyle = def.finColor;
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.ellipse(s * 0.3, -s * 0.4, s * 0.2, s * 0.18, -0.3, 0, Math.PI * 2);
  ctx.fill();
  ctx.stroke();
  ctx.beginPath();
  ctx.moveTo(s * 0.2, -s * 0.3);
  ctx.quadraticCurveTo(s * 0.5, -s * 0.1, s * 0.3, s * 0.2);
  ctx.quadraticCurveTo(s * 0.1, s * 0.4, s * 0.15, s * 0.6);
  ctx.quadraticCurveTo(s * 0.05, s * 0.4, 0, s * 0.15);
  ctx.quadraticCurveTo(-s * 0.15, -s * 0.1, s * 0.05, -s * 0.35);
  ctx.closePath();
  ctx.fill();
  ctx.stroke();
  ctx.beginPath();
  ctx.moveTo(s * 0.15, s * 0.6);
  ctx.quadraticCurveTo(-s * 0.15, s * 0.75, -s * 0.1, s * 0.85);
  ctx.quadraticCurveTo(0, s * 0.9, s * 0.05, s * 0.8);
  ctx.stroke();
  ctx.beginPath();
  ctx.moveTo(s * 0.45, -s * 0.4);
  ctx.lineTo(s * 0.65, -s * 0.4);
  ctx.stroke();
  ctx.fillStyle = '#000';
  ctx.beginPath();
  ctx.arc(s * 0.35, -s * 0.42, s * 0.04, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = def.finColor;
  ctx.globalAlpha *= 0.7;
  ctx.beginPath();
  ctx.ellipse(0, -s * 0.05, s * 0.06, s * 0.15, 0.2, 0, Math.PI * 2);
  ctx.fill();
}

function drawRealTurtle(f, s, time) {
  const def = f.def;
  const shellGrad = ctx.createRadialGradient(-s*0.2, -s*0.2, s*0.1, 0, 0, s*0.9);
  shellGrad.addColorStop(0, def.color2);
  shellGrad.addColorStop(1, def.color);
  ctx.fillStyle = shellGrad;
  ctx.beginPath();
  ctx.ellipse(0, 0, s * 0.85, s * 0.65, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.strokeStyle = '#1a202c';
  ctx.lineWidth = 2;
  ctx.stroke();
  ctx.strokeStyle = 'rgba(0,0,0,0.4)';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.ellipse(0, 0, s * 0.55, s * 0.4, 0, 0, Math.PI * 2);
  ctx.stroke();
  for (let i = 0; i < 6; i++) {
    const a = (i / 6) * Math.PI * 2;
    ctx.beginPath();
    ctx.moveTo(Math.cos(a) * s * 0.55, Math.sin(a) * s * 0.4);
    ctx.lineTo(Math.cos(a) * s * 0.85, Math.sin(a) * s * 0.65);
    ctx.stroke();
  }
  ctx.fillStyle = def.color;
  ctx.beginPath();
  ctx.ellipse(s * 0.9, 0, s * 0.2, s * 0.16, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.stroke();
  ctx.fillStyle = '#000';
  ctx.beginPath();
  ctx.arc(s * 1.0, -s * 0.05, s * 0.04, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = def.color;
  ctx.beginPath();
  ctx.ellipse(s * 0.65, -s * 0.5, s * 0.2, s * 0.1, -0.6 + Math.sin(time*3+f.phase)*0.1, 0, Math.PI * 2);
  ctx.fill();
  ctx.beginPath();
  ctx.ellipse(s * 0.65, s * 0.5, s * 0.2, s * 0.1, 0.6 - Math.sin(time*3+f.phase)*0.1, 0, Math.PI * 2);
  ctx.fill();
  ctx.beginPath();
  ctx.ellipse(-s * 0.7, -s * 0.4, s * 0.18, s * 0.09, -0.8 + Math.sin(time*3+f.phase)*0.1, 0, Math.PI * 2);
  ctx.fill();
  ctx.beginPath();
  ctx.ellipse(-s * 0.7, s * 0.4, s * 0.18, s * 0.09, 0.8 - Math.sin(time*3+f.phase)*0.1, 0, Math.PI * 2);
  ctx.fill();
}

function drawRealRay(f, s, time, isManta) {
  const def = f.def;
  const wing = Math.sin(time * 2 + f.phase) * 0.15;
  const wingGrad = ctx.createLinearGradient(-s * 1.2, 0, s * 1.2, 0);
  wingGrad.addColorStop(0, def.color);
  wingGrad.addColorStop(0.5, def.color2);
  wingGrad.addColorStop(1, def.color);
  ctx.fillStyle = wingGrad;
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.quadraticCurveTo(-s * 0.6, -s * 0.4 + wing * s, -s * 1.3, -s * 0.2 + wing * s * 1.5);
  ctx.quadraticCurveTo(-s * 1.1, 0, -s * 1.3, s * 0.2 - wing * s * 1.5);
  ctx.quadraticCurveTo(-s * 0.6, s * 0.4 - wing * s, 0, 0);
  ctx.closePath();
  ctx.fill();
  ctx.strokeStyle = 'rgba(0,0,0,0.3)';
  ctx.lineWidth = 1.5;
  ctx.stroke();
  ctx.fillStyle = def.color;
  ctx.beginPath();
  ctx.ellipse(0, 0, s * 0.5, s * 0.25, 0, 0, Math.PI * 2);
  ctx.fill();
  if (isManta) {
    ctx.fillStyle = def.color;
    ctx.beginPath();
    ctx.moveTo(s * 0.4, -s * 0.1);
    ctx.lineTo(s * 0.6, -s * 0.15);
    ctx.lineTo(s * 0.5, -s * 0.05);
    ctx.closePath();
    ctx.fill();
    ctx.beginPath();
    ctx.moveTo(s * 0.4, s * 0.1);
    ctx.lineTo(s * 0.6, s * 0.15);
    ctx.lineTo(s * 0.5, s * 0.05);
    ctx.closePath();
    ctx.fill();
  }
  ctx.strokeStyle = def.finColor || def.color;
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(-s * 0.4, 0);
  ctx.quadraticCurveTo(-s * 1.0, Math.sin(time * 3) * s * 0.15, -s * 1.8, Math.sin(time * 3 + 0.5) * s * 0.2);
  ctx.stroke();
  ctx.fillStyle = '#000';
  ctx.beginPath();
  ctx.arc(s * 0.5, -s * 0.05, s * 0.04, 0, Math.PI * 2);
  ctx.fill();
  ctx.beginPath();
  ctx.arc(s * 0.5, s * 0.05, s * 0.04, 0, Math.PI * 2);
  ctx.fill();
}

// =====================================================
// КИТЫ — теперь опасные, с золотой разновидностью
// =====================================================
function drawWhale(w, x, y, time) {
  const def = w.def;
  const s = def.size;
  const tail = Math.sin(w.tailPhase) * 0.4;
  const chasing = w.state === 'chase';
  
  ctx.save();
  ctx.translate(x, y);
  ctx.rotate(w.angle);
  ctx.globalAlpha = 1 - nightTransition * 0.4;

  // Золотое свечение для золотого кита
  if (def.golden) {
    const goldGlow = ctx.createRadialGradient(0, 0, s * 0.3, 0, 0, s * 1.5);
    goldGlow.addColorStop(0, 'rgba(255,215,0,0.5)');
    goldGlow.addColorStop(0.5, 'rgba(255,180,0,0.2)');
    goldGlow.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = goldGlow;
    ctx.beginPath();
    ctx.arc(0, 0, s * 1.5, 0, Math.PI * 2);
    ctx.fill();
  }

  // Аура агрессии
  if (chasing && def.dangerous) {
    const aggroGlow = ctx.createRadialGradient(0, 0, s * 0.3, 0, 0, s * 1.2);
    aggroGlow.addColorStop(0, def.golden ? 'rgba(255,80,80,0.4)' : 'rgba(255,0,0,0.3)');
    aggroGlow.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = aggroGlow;
    ctx.beginPath();
    ctx.arc(0, 0, s * 1.2, 0, Math.PI * 2);
    ctx.fill();
  }

  // Тело кита
  const grad = ctx.createLinearGradient(0, -s * 0.3, 0, s * 0.3);
  grad.addColorStop(0, def.color);
  grad.addColorStop(0.5, def.color2);
  grad.addColorStop(1, def.color);
  ctx.fillStyle = grad;
  ctx.beginPath();
  ctx.ellipse(0, 0, s * 0.6, s * 0.22, 0, 0, Math.PI * 2);
  ctx.fill();
  
  // Светлая полоса на животе
  ctx.fillStyle = 'rgba(255,255,255,0.2)';
  ctx.beginPath();
  ctx.ellipse(0, s * 0.08, s * 0.5, s * 0.08, 0, 0, Math.PI * 2);
  ctx.fill();

  // Хвост
  ctx.fillStyle = def.color;
  ctx.beginPath();
  ctx.moveTo(-s * 0.55, 0);
  ctx.lineTo(-s * 0.85, -s * 0.25 + tail * s * 0.15);
  ctx.lineTo(-s * 0.9, tail * s * 0.2);
  ctx.lineTo(-s * 0.85, s * 0.25 + tail * s * 0.15);
  ctx.closePath();
  ctx.fill();

  // Спинной плавник
  ctx.beginPath();
  ctx.moveTo(-s * 0.15, -s * 0.18);
  ctx.lineTo(s * 0.1, -s * 0.18);
  ctx.lineTo(0, -s * 0.45);
  ctx.closePath();
  ctx.fill();

  // Брюшные борозды
  ctx.strokeStyle = 'rgba(0,0,0,0.15)';
  ctx.lineWidth = 2;
  for (let i = 0; i < 4; i++) {
    ctx.beginPath();
    ctx.moveTo(s * 0.2 + i * s * 0.05, -s * 0.1);
    ctx.lineTo(s * 0.2 + i * s * 0.05, s * 0.15);
    ctx.stroke();
  }

  // Глаз
  ctx.fillStyle = chasing && def.dangerous ? '#ff0000' : '#000';
  ctx.beginPath();
  ctx.arc(s * 0.5, s * 0.05, s * 0.025, 0, Math.PI * 2);
  ctx.fill();

  // Для золотого кита — золотые блики
  if (def.golden) {
    ctx.fillStyle = 'rgba(255,255,255,0.6)';
    for (let i = 0; i < 6; i++) {
      const ang = (i / 6) * Math.PI * 2;
      const px = Math.cos(ang) * s * 0.4;
      const py = Math.sin(ang) * s * 0.15;
      ctx.beginPath();
      ctx.arc(px, py, s * 0.02, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  // Индикатор атаки — красные молнии
  if (chasing && def.dangerous) {
    ctx.strokeStyle = 'rgba(255,0,0,0.8)';
    ctx.lineWidth = 2;
    for (let i = 0; i < 3; i++) {
      const offset = Math.sin(time * 10 + i) * 5;
      ctx.beginPath();
      ctx.moveTo(s * 0.7 + i * 8, -s * 0.3 + offset);
      ctx.lineTo(s * 0.75 + i * 8, -s * 0.15 + offset);
      ctx.lineTo(s * 0.7 + i * 8, 0 + offset);
      ctx.stroke();
    }
  }

  ctx.restore();
}

function drawDolphin(d, x, y, time) {
  const def = d.def;
  const s = def.size;
  const tail = Math.sin(d.tailPhase) * 0.5;
  ctx.save();
  ctx.translate(x, y);
  ctx.rotate(d.angle);
  ctx.globalAlpha = 1 - nightTransition * 0.4;
  const grad = ctx.createLinearGradient(0, -s * 0.4, 0, s * 0.4);
  grad.addColorStop(0, def.color);
  grad.addColorStop(0.5, def.color2);
  grad.addColorStop(1, def.color);
  ctx.fillStyle = grad;
  ctx.beginPath();
  ctx.ellipse(0, 0, s * 0.55, s * 0.22, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.beginPath();
  ctx.moveTo(-s * 0.5, 0);
  ctx.lineTo(-s * 0.8, -s * 0.3 + tail * s * 0.2);
  ctx.lineTo(-s * 0.85, tail * s * 0.25);
  ctx.lineTo(-s * 0.8, s * 0.3 + tail * s * 0.2);
  ctx.closePath();
  ctx.fill();
  ctx.beginPath();
  ctx.moveTo(-s * 0.15, -s * 0.18);
  ctx.lineTo(s * 0.1, -s * 0.18);
  ctx.lineTo(-s * 0.05, -s * 0.42);
  ctx.closePath();
  ctx.fill();
  ctx.beginPath();
  ctx.moveTo(s * 0.5, -s * 0.05);
  ctx.lineTo(s * 0.8, 0);
  ctx.lineTo(s * 0.5, s * 0.05);
  ctx.closePath();
  ctx.fill();
  ctx.beginPath();
  ctx.moveTo(s * 0.1, s * 0.15);
  ctx.lineTo(-s * 0.1, s * 0.35);
  ctx.lineTo(s * 0.2, s * 0.2);
  ctx.closePath();
  ctx.fill();
  ctx.fillStyle = '#000';
  ctx.beginPath();
  ctx.arc(s * 0.4, -s * 0.02, s * 0.03, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();
}

function drawBoat(b, camX, camY, time) {
  if (!b.visible) return;
  const x = b.x - camX;
  const sy = waveY(b.x, time) - camY;
  if (x < -300 || x > W + 300) return;
  const bob = Math.sin(b.bobPhase) * 4;
  const tilt = Math.sin(b.bobPhase * 0.5) * 0.05;
  const W_ = b.type.w, H_ = b.type.h;
  ctx.save();
  ctx.translate(x, sy + bob);
  ctx.rotate(tilt);
  if (b.direction < 0) ctx.scale(-1, 1);
  ctx.globalAlpha = 1 - nightTransition * 0.4;
  ctx.fillStyle = 'rgba(0,0,0,0.3)';
  ctx.beginPath();
  ctx.ellipse(0, H_ * 0.7, W_ * 0.55, 6, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = b.type.color;
  ctx.beginPath();
  ctx.moveTo(-W_/2, -H_/2);
  ctx.lineTo(W_/2 - 10, -H_/2);
  ctx.lineTo(W_/2, 0);
  ctx.lineTo(W_/2 - 10, H_/2);
  ctx.lineTo(-W_/2, H_/2);
  ctx.lineTo(-W_/2 - 8, 0);
  ctx.closePath();
  ctx.fill();
  ctx.strokeStyle = 'rgba(0,0,0,0.5)';
  ctx.lineWidth = 2;
  ctx.stroke();
  if (b.type.sail) {
    ctx.fillStyle = b.type.sail;
    ctx.beginPath();
    ctx.moveTo(0, -H_/2);
    ctx.lineTo(0, -H_/2 - H_ * 3);
    ctx.lineTo(-W_ * 0.4, -H_/2);
    ctx.closePath();
    ctx.fill();
  }
  ctx.restore();
}

// =====================================================
// УЛУЧШЕННЫЕ КРОЛЬ И БАТТЕРФЛЯЙ
// =====================================================
function drawRealisticSwimmer(time) {
  const colors = getActiveColors();
  const activeGlow = getActiveGlow();
  const style = getStyle();
  const animType = style.animType;

  ctx.save();
  ctx.translate(W / 2, H / 2);

  if (activeGlow) {
    const glowGrad = ctx.createRadialGradient(0, 0, 30, 0, 0, 120);
    glowGrad.addColorStop(0, activeGlow);
    glowGrad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = glowGrad;
    ctx.beginPath();
    ctx.arc(0, 0, 120, 0, Math.PI * 2);
    ctx.fill();
  }

  if (hasShield()) {
    const shieldGrad = ctx.createRadialGradient(0, 0, 40, 0, 0, 100);
    shieldGrad.addColorStop(0, 'rgba(120, 200, 255, 0)');
    shieldGrad.addColorStop(0.7, 'rgba(120, 200, 255, 0.35)');
    shieldGrad.addColorStop(1, 'rgba(120, 200, 255, 0)');
    ctx.fillStyle = shieldGrad;
    ctx.beginPath();
    ctx.arc(0, 0, 100, 0, Math.PI * 2);
    ctx.fill();
  }

  ctx.rotate(player.angle);

  const S = player.size * 2.4;
  const skinColor = colors.skin;
  const suitColor = colors.body;
  const capColor = colors.cap;
  const glassColor = colors.glass;

  const strokeL = Math.sin(player.strokePhase);
  const strokeR = Math.sin(player.strokePhase + Math.PI);
  const legL = Math.sin(player.legPhase);
  const legR = Math.sin(player.legPhase + Math.PI);

  if (animType === 'backstroke') {
    drawBackstroke(S, skinColor, suitColor, capColor, glassColor, strokeL, strokeR, legL, legR, time);
  } else if (animType === 'breaststroke') {
    drawBreaststroke(S, skinColor, suitColor, capColor, glassColor, strokeL, legL, time);
  } else if (animType === 'butterfly') {
    drawButterfly(S, skinColor, suitColor, capColor, glassColor, strokeL, legL, time);
  } else {
    drawCrawl(S, skinColor, suitColor, capColor, glassColor, strokeL, strokeR, legL, legR, time);
  }

  ctx.restore();
}

function drawSwimTrunks(S, suitColor, cx, cy, rot, isBack) {
  ctx.save();
  ctx.translate(cx, cy);
  ctx.rotate(rot);
  ctx.fillStyle = suitColor;
  ctx.beginPath();
  if (isBack) {
    ctx.moveTo(-S * 0.22, -S * 0.05);
    ctx.lineTo(S * 0.18, -S * 0.05);
    ctx.lineTo(S * 0.16, S * 0.20);
    ctx.lineTo(S * 0.02, S * 0.20);
    ctx.lineTo(S * 0.02, S * 0.05);
    ctx.lineTo(-S * 0.05, S * 0.05);
    ctx.lineTo(-S * 0.05, S * 0.20);
    ctx.lineTo(-S * 0.22, S * 0.20);
    ctx.closePath();
  } else {
    ctx.moveTo(-S * 0.25, -S * 0.04);
    ctx.lineTo(S * 0.15, -S * 0.04);
    ctx.lineTo(S * 0.14, S * 0.18);
    ctx.lineTo(-S * 0.01, S * 0.18);
    ctx.lineTo(-S * 0.01, S * 0.02);
    ctx.lineTo(-S * 0.06, S * 0.02);
    ctx.lineTo(-S * 0.06, S * 0.18);
    ctx.lineTo(-S * 0.25, S * 0.18);
    ctx.closePath();
  }
  ctx.fill();

  ctx.fillStyle = 'rgba(0,0,0,0.55)';
  ctx.beginPath();
  if (isBack) {
    ctx.moveTo(S * 0.12, -S * 0.05);
    ctx.lineTo(S * 0.18, -S * 0.05);
    ctx.lineTo(S * 0.16, S * 0.20);
    ctx.lineTo(S * 0.08, S * 0.20);
    ctx.closePath();
  } else {
    ctx.moveTo(S * 0.08, -S * 0.04);
    ctx.lineTo(S * 0.15, -S * 0.04);
    ctx.lineTo(S * 0.14, S * 0.18);
    ctx.lineTo(S * 0.07, S * 0.18);
    ctx.closePath();
  }
  ctx.fill();

  ctx.fillStyle = 'rgba(255,255,255,0.75)';
  ctx.fillRect(-S * 0.20, S * 0.06, S * 0.14, S * 0.012);
  ctx.fillRect(-S * 0.20, S * 0.085, S * 0.10, S * 0.012);

  ctx.restore();
}

function drawHead(S, skinColor, capColor, glassColor, cx, cy, rot, lookingDir, isBack) {
  ctx.save();
  ctx.translate(cx, cy);
  ctx.rotate(rot);

  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.ellipse(0, S * 0.05, S * 0.10, S * 0.08, 0, 0, Math.PI * 2);
  ctx.fill();

  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.ellipse(S * 0.05, 0, S * 0.14, S * 0.16, 0, 0, Math.PI * 2);
  ctx.fill();

  ctx.beginPath();
  ctx.moveTo(S * 0.13, -S * 0.02);
  ctx.quadraticCurveTo(S * 0.20, 0, S * 0.16, S * 0.05);
  ctx.quadraticCurveTo(S * 0.12, S * 0.08, S * 0.10, S * 0.10);
  ctx.closePath();
  ctx.fill();

  ctx.beginPath();
  ctx.arc(S * 0.0, 0, S * 0.03, 0, Math.PI * 2);
  ctx.fill();

  ctx.fillStyle = capColor;
  ctx.beginPath();
  ctx.ellipse(S * 0.04, -S * 0.02, S * 0.15, S * 0.17, 0, Math.PI * 0.9, Math.PI * 2.1);
  ctx.lineTo(S * 0.10, S * 0.02);
  ctx.closePath();
  ctx.fill();

  ctx.strokeStyle = glassColor;
  ctx.lineWidth = 2.2;
  ctx.beginPath();
  ctx.ellipse(S * 0.16, -S * 0.02, S * 0.035, S * 0.028, 0, 0, Math.PI * 2);
  ctx.stroke();
  ctx.fillStyle = 'rgba(120, 220, 255, 0.55)';
  ctx.fill();

  ctx.strokeStyle = 'rgba(20,20,30,0.85)';
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(S * 0.13, -S * 0.05);
  ctx.lineTo(S * -0.05, -S * 0.06);
  ctx.stroke();

  ctx.restore();
}

// === УЛУЧШЕННЫЙ КРОЛЬ ===
// Пловец на боку, одна рука над водой вытянута, другая под водой, дыхание вбок
function drawCrawl(S, skinColor, suitColor, capColor, glassColor, strokeL, strokeR, legL, legR, time) {
  // Определяем фазу: 0..1 — цикл гребка
  const phaseL = (player.strokePhase % (Math.PI * 2)) / (Math.PI * 2); // 0..1
  const phaseR = (phaseL + 0.5) % 1;
  
  // Тело на боку — поворот корпуса (roll)
  const bodyRoll = Math.sin(player.strokePhase) * 0.25;
  
  // Ноги — поочерёдные, мощные
  const kickAmp = 0.5;
  ctx.save();
  ctx.translate(-S * 0.30, S * 0.02);
  ctx.rotate(-bodyRoll * 0.5 + legL * kickAmp);
  // Бедро + голень + стопа
  ctx.strokeStyle = suitColor;
  ctx.lineWidth = S * 0.11;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(-S * 0.28, 0);
  ctx.stroke();
  ctx.save();
  ctx.translate(-S * 0.28, 0);
  ctx.rotate(0.3 + Math.abs(legL) * 0.4);
  ctx.strokeStyle = skinColor;
  ctx.lineWidth = S * 0.075;
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(-S * 0.24, 0);
  ctx.stroke();
  // Стопа вытянута (как у пловца)
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.moveTo(-S * 0.24, 0);
  ctx.lineTo(-S * 0.34, -S * 0.02);
  ctx.lineTo(-S * 0.34, S * 0.02);
  ctx.closePath();
  ctx.fill();
  ctx.restore();
  ctx.restore();

  // Вторая нога — противофаза
  ctx.save();
  ctx.translate(-S * 0.30, -S * 0.02);
  ctx.rotate(-bodyRoll * 0.5 + legR * kickAmp);
  ctx.strokeStyle = suitColor;
  ctx.lineWidth = S * 0.11;
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(-S * 0.28, 0);
  ctx.stroke();
  ctx.save();
  ctx.translate(-S * 0.28, 0);
  ctx.rotate(0.3 + Math.abs(legR) * 0.4);
  ctx.strokeStyle = skinColor;
  ctx.lineWidth = S * 0.075;
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(-S * 0.24, 0);
  ctx.stroke();
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.moveTo(-S * 0.24, 0);
  ctx.lineTo(-S * 0.34, -S * 0.02);
  ctx.lineTo(-S * 0.34, S * 0.02);
  ctx.closePath();
  ctx.fill();
  ctx.restore();
  ctx.restore();

  // Торс — повёрнут на бок
  ctx.save();
  ctx.rotate(-0.08 + bodyRoll * 0.3);
  const torsoGrad = ctx.createLinearGradient(0, -S * 0.4, 0, S * 0.4);
  torsoGrad.addColorStop(0, suitColor);
  torsoGrad.addColorStop(0.5, skinColor);
  torsoGrad.addColorStop(1, skinColor);
  ctx.fillStyle = torsoGrad;
  ctx.beginPath();
  ctx.moveTo(S * 0.28, -S * 0.14);
  ctx.bezierCurveTo(S * 0.15, -S * 0.22, -S * 0.10, -S * 0.20, -S * 0.28, -S * 0.10);
  ctx.lineTo(-S * 0.28, S * 0.10);
  ctx.bezierCurveTo(-S * 0.10, S * 0.20, S * 0.15, S * 0.22, S * 0.28, S * 0.14);
  ctx.closePath();
  ctx.fill();

  // Линия позвоночника (рельеф спины)
  ctx.strokeStyle = 'rgba(0,0,0,0.2)';
  ctx.lineWidth = 1.2;
  ctx.beginPath();
  ctx.moveTo(-S * 0.18, -S * 0.16);
  ctx.quadraticCurveTo(-S * 0.02, 0, -S * 0.18, S * 0.16);
  ctx.stroke();

  // Мышцы спины — пара линий
  ctx.strokeStyle = 'rgba(0,0,0,0.15)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(S * 0.05, -S * 0.14);
  ctx.quadraticCurveTo(-S * 0.05, 0, S * 0.05, S * 0.14);
  ctx.stroke();
  ctx.restore();

  // Плавки
  drawSwimTrunks(S, suitColor, -S * 0.22, 0, -0.08, false);

  // === РУКИ В КРОЛЕ ===
  // Задняя рука (под водой, гребёт назад)
  ctx.save();
  ctx.translate(S * 0.08, S * 0.08);
  const backArmAngle = -0.8 + strokeL * 2.2; // от 0.8 до -2.2
  ctx.rotate(backArmAngle);
  // Плечо
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.arc(0, 0, S * 0.075, 0, Math.PI * 2);
  ctx.fill();
  // Верхняя рука
  ctx.strokeStyle = skinColor;
  ctx.lineWidth = S * 0.075;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(S * 0.24, 0);
  ctx.stroke();
  // Предплечье
  ctx.save();
  ctx.translate(S * 0.24, 0);
  ctx.rotate(0.3 + Math.max(0, -strokeL) * 0.5);
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(S * 0.22, 0);
  ctx.stroke();
  // Кисть-лопасть
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.ellipse(S * 0.24, 0, S * 0.05, S * 0.035, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();
  ctx.restore();

  // Передняя рука (над водой или входит)
  ctx.save();
  ctx.translate(S * 0.12, -S * 0.08);
  const frontArmAngle = -2.2 + strokeR * 2.4; // от -2.2 до 0.2
  ctx.rotate(frontArmAngle);
  // Плечо
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.arc(0, 0, S * 0.075, 0, Math.PI * 2);
  ctx.fill();
  // Рука
  ctx.strokeStyle = skinColor;
  ctx.lineWidth = S * 0.075;
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(S * 0.26, 0);
  ctx.stroke();
  // Предплечье — при гребке сгибается
  ctx.save();
  ctx.translate(S * 0.26, 0);
  const elbowBend = Math.max(0, Math.sin(player.strokePhase + 1)) * 0.7;
  ctx.rotate(elbowBend);
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(S * 0.22, 0);
  ctx.stroke();
  // Кисть
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.ellipse(S * 0.24, 0, S * 0.055, S * 0.04, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();
  ctx.restore();

  // Голова — в воде или на боку (при вдохе)
  const headTurn = Math.sin(player.strokePhase + Math.PI * 0.5) * 0.3;
  drawHead(S, skinColor, capColor, glassColor, S * 0.30, -bodyRoll * S * 0.05, 0.15 + headTurn, 0, false);
}

// === УЛУЧШЕННЫЙ БАТТЕРФЛЯЙ ===
// Обе руки одновременно выбрасываются вперёд, тело волной, ноги дельфиний удар
function drawButterfly(S, skinColor, suitColor, capColor, glassColor, stroke, legPhase, time) {
  // Фазы: 0..1 цикл
  const phase = (player.strokePhase % (Math.PI * 2)) / (Math.PI * 2);
  
  // Волнообразное движение тела
  const bodyWave = Math.sin(player.strokePhase) * 0.15;
  const hipWave = Math.sin(player.legPhase) * 0.25;
  
  // Ноги — дельфиний удар (вместе, волной)
  ctx.save();
  ctx.translate(-S * 0.30, S * 0.02);
  ctx.rotate(hipWave * 0.5);
  // Бедро
  ctx.strokeStyle = suitColor;
  ctx.lineWidth = S * 0.13;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(-S * 0.24, 0);
  ctx.stroke();
  // Голень — гнётся
  ctx.save();
  ctx.translate(-S * 0.24, 0);
  ctx.rotate(0.4 + hipWave * 0.6);
  ctx.strokeStyle = skinColor;
  ctx.lineWidth = S * 0.09;
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(-S * 0.26, 0);
  ctx.stroke();
  // Стопа-ласта
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.moveTo(-S * 0.26, -S * 0.02);
  ctx.lineTo(-S * 0.38, 0);
  ctx.lineTo(-S * 0.26, S * 0.02);
  ctx.closePath();
  ctx.fill();
  ctx.restore();
  ctx.restore();

  // Вторая нога (немного отстаёт)
  ctx.save();
  ctx.translate(-S * 0.30, -S * 0.03);
  ctx.rotate(hipWave * 0.5 + 0.05);
  ctx.strokeStyle = suitColor;
  ctx.lineWidth = S * 0.12;
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(-S * 0.22, 0);
  ctx.stroke();
  ctx.save();
  ctx.translate(-S * 0.22, 0);
  ctx.rotate(0.4 + hipWave * 0.6 + 0.05);
  ctx.strokeStyle = skinColor;
  ctx.lineWidth = S * 0.085;
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(-S * 0.24, 0);
  ctx.stroke();
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.moveTo(-S * 0.24, -S * 0.02);
  ctx.lineTo(-S * 0.36, 0);
  ctx.lineTo(-S * 0.24, S * 0.02);
  ctx.closePath();
  ctx.fill();
  ctx.restore();
  ctx.restore();

  // Торс — волной
  ctx.save();
  ctx.rotate(-0.05 + bodyWave);
  
  const torsoGrad = ctx.createLinearGradient(0, -S * 0.4, 0, S * 0.4);
  torsoGrad.addColorStop(0, suitColor);
  torsoGrad.addColorStop(0.5, skinColor);
  torsoGrad.addColorStop(1, skinColor);
  ctx.fillStyle = torsoGrad;
  ctx.beginPath();
  ctx.moveTo(S * 0.28, -S * 0.15);
  ctx.bezierCurveTo(S * 0.15, -S * 0.24, -S * 0.10, -S * 0.22, -S * 0.30, -S * 0.10);
  ctx.lineTo(-S * 0.30, S * 0.10);
  ctx.bezierCurveTo(-S * 0.10, S * 0.22, S * 0.15, S * 0.24, S * 0.28, S * 0.15);
  ctx.closePath();
  ctx.fill();

  // Рельеф мышц спины
  ctx.strokeStyle = 'rgba(0,0,0,0.2)';
  ctx.lineWidth = 1.2;
  ctx.beginPath();
  ctx.moveTo(-S * 0.10, -S * 0.18);
  ctx.quadraticCurveTo(S * 0.05, -S * 0.05, -S * 0.10, S * 0.18);
  ctx.stroke();
  
  // Лопатки
  ctx.beginPath();
  ctx.moveTo(S * 0.05, -S * 0.15);
  ctx.quadraticCurveTo(S * 0.12, -S * 0.10, S * 0.05, -S * 0.02);
  ctx.moveTo(S * 0.05, S * 0.15);
  ctx.quadraticCurveTo(S * 0.12, S * 0.10, S * 0.05, S * 0.02);
  ctx.stroke();
  ctx.restore();

  // Плавки
  drawSwimTrunks(S, suitColor, -S * 0.22, 0, -0.05, false);

  // === РУКИ БАТТЕРФЛЯЙ ===
  // Обе руки одновременно выбрасываются вперёд, затем уходят под воду назад
  // Фаза 0..0.5: руки над водой идут вперёд
  // Фаза 0.5..1: руки под водой гребут назад
  
  const armPhase = phase; // 0..1
  
  // Углы рук (от плеча)
  let armAngle, forearmAngle;
  if (armPhase < 0.5) {
    // Над водой — вперёд
    const t = armPhase * 2; // 0..1
    armAngle = -1.8 + t * 1.8; // от -1.8 (назад) до 0 (вперёд)
    forearmAngle = 0.3 - t * 0.3;
  } else {
    // Под водой — гребок назад
    const t = (armPhase - 0.5) * 2; // 0..1
    armAngle = 0 - t * 1.8; // от 0 (вперёд) до -1.8 (назад)
    forearmAngle = -0.2 + t * 0.5;
  }
  
  // Движение кистей (ладони смотрят вниз)
  const handAngle = Math.sin(armPhase * Math.PI * 2) * 0.3;
  
  // Верхняя рука (видна лучше)
  ctx.save();
  ctx.translate(S * 0.18, -S * 0.10);
  ctx.rotate(armAngle);
  // Плечо
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.arc(0, 0, S * 0.08, 0, Math.PI * 2);
  ctx.fill();
  // Рука
  ctx.strokeStyle = skinColor;
  ctx.lineWidth = S * 0.08;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(S * 0.26, 0);
  ctx.stroke();
  // Предплечье
  ctx.save();
  ctx.translate(S * 0.26, 0);
  ctx.rotate(forearmAngle);
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(S * 0.22, 0);
  ctx.stroke();
  // Кисть с растопыренными пальцами (лопасть)
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.ellipse(S * 0.24, 0, S * 0.06, S * 0.04, handAngle, 0, Math.PI * 2);
  ctx.fill();
  // Линия пальцев
  ctx.strokeStyle = 'rgba(0,0,0,0.3)';
  ctx.lineWidth = 0.8;
  for (let f = -1; f <= 1; f++) {
    ctx.beginPath();
    ctx.moveTo(S * 0.22, f * S * 0.015);
    ctx.lineTo(S * 0.28, f * S * 0.025);
    ctx.stroke();
  }
  ctx.restore();
  ctx.restore();

  // Нижняя рука (немного отстаёт по фазе)
  ctx.save();
  ctx.translate(S * 0.18, S * 0.10);
  ctx.rotate(armAngle + 0.05);
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.arc(0, 0, S * 0.08, 0, Math.PI * 2);
  ctx.fill();
  ctx.strokeStyle = skinColor;
  ctx.lineWidth = S * 0.08;
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(S * 0.26, 0);
  ctx.stroke();
  ctx.save();
  ctx.translate(S * 0.26, 0);
  ctx.rotate(forearmAngle + 0.05);
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(S * 0.22, 0);
  ctx.stroke();
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.ellipse(S * 0.24, 0, S * 0.06, S * 0.04, handAngle, 0, Math.PI * 2);
  ctx.fill();
  ctx.strokeStyle = 'rgba(0,0,0,0.3)';
  ctx.lineWidth = 0.8;
  for (let f = -1; f <= 1; f++) {
    ctx.beginPath();
    ctx.moveTo(S * 0.22, f * S * 0.015);
    ctx.lineTo(S * 0.28, f * S * 0.025);
    ctx.stroke();
  }
  ctx.restore();
  ctx.restore();

  // Голова — поднимается при вдохе (когда руки над водой идут вперёд)
  // При фазе 0..0.5 — вдох (голова вверху), при 0.5..1 — голова в воде
  let headLift = 0;
  if (armPhase < 0.5) {
    headLift = Math.sin(armPhase * 2 * Math.PI) * 0.5;
  } else {
    headLift = Math.max(0, Math.sin((armPhase - 0.5) * 2 * Math.PI + Math.PI)) * 0.3;
  }
  
  drawHead(S, skinColor, capColor, glassColor, S * 0.30, -headLift * S * 0.08, 0.05 - headLift * 0.5, 0, false);
}

function drawBreaststroke(S, skinColor, suitColor, capColor, glassColor, stroke, legPhase, time) {
  const kick = Math.sin(legPhase);
  ctx.save();
  ctx.translate(-S * 0.30, -S * 0.06);
  ctx.rotate(0.35 + Math.max(0, -kick) * 0.5);
  ctx.strokeStyle = suitColor;
  ctx.lineWidth = S * 0.11;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(-S * 0.22, 0);
  ctx.stroke();
  ctx.save();
  ctx.translate(-S * 0.22, 0);
  ctx.rotate(0.4 + kick * 0.5);
  ctx.strokeStyle = skinColor;
  ctx.lineWidth = S * 0.075;
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(-S * 0.20, 0);
  ctx.stroke();
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.ellipse(-S * 0.22, 0, S * 0.05, S * 0.03, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();
  ctx.restore();

  ctx.save();
  ctx.translate(-S * 0.30, S * 0.06);
  ctx.rotate(-0.35 - Math.max(0, -kick) * 0.5);
  ctx.strokeStyle = suitColor;
  ctx.lineWidth = S * 0.11;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(-S * 0.22, 0);
  ctx.stroke();
  ctx.save();
  ctx.translate(-S * 0.22, 0);
  ctx.rotate(-0.4 - kick * 0.5);
  ctx.strokeStyle = skinColor;
  ctx.lineWidth = S * 0.075;
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(-S * 0.20, 0);
  ctx.stroke();
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.ellipse(-S * 0.22, 0, S * 0.05, S * 0.03, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();
  ctx.restore();

  ctx.save();
  ctx.rotate(-0.15);
  const torsoGrad = ctx.createLinearGradient(0, -S * 0.4, 0, S * 0.4);
  torsoGrad.addColorStop(0, suitColor);
  torsoGrad.addColorStop(0.5, skinColor);
  torsoGrad.addColorStop(1, skinColor);
  ctx.fillStyle = torsoGrad;
  ctx.beginPath();
  ctx.moveTo(S * 0.28, -S * 0.14);
  ctx.bezierCurveTo(S * 0.15, -S * 0.22, -S * 0.10, -S * 0.22, -S * 0.28, -S * 0.10);
  ctx.lineTo(-S * 0.28, S * 0.10);
  ctx.bezierCurveTo(-S * 0.10, S * 0.22, S * 0.15, S * 0.22, S * 0.28, S * 0.14);
  ctx.closePath();
  ctx.fill();
  ctx.restore();

  drawSwimTrunks(S, suitColor, -S * 0.22, 0, -0.15, false);

  const reach = (stroke + 1) * 0.5;
  const armAngle = -0.5 + reach * 1.4;

  ctx.save();
  ctx.translate(S * 0.18, -S * 0.10);
  ctx.rotate(armAngle);
  drawArm(S, skinColor, suitColor, 0, 0, 0, -0.3 + reach * 0.4, 0, false);
  ctx.restore();

  ctx.save();
  ctx.translate(S * 0.18, S * 0.10);
  ctx.rotate(armAngle);
  drawArm(S, skinColor, suitColor, 0, 0, 0, -0.3 + reach * 0.4, 0, false);
  ctx.restore();

  drawHead(S, skinColor, capColor, glassColor, S * 0.30, -S * 0.08, -0.35, 0, false);
}

function drawBackstroke(S, skinColor, suitColor, capColor, glassColor, strokeL, strokeR, legL, legR, time) {
  ctx.save();
  ctx.translate(-S * 0.30, -S * 0.04);
  ctx.rotate(legL * 0.3);
  ctx.strokeStyle = suitColor;
  ctx.lineWidth = S * 0.10;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(-S * 0.24, 0);
  ctx.stroke();
  ctx.strokeStyle = skinColor;
  ctx.lineWidth = S * 0.07;
  ctx.beginPath();
  ctx.moveTo(-S * 0.24, 0);
  ctx.lineTo(-S * 0.44, 0);
  ctx.stroke();
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.ellipse(-S * 0.47, 0, S * 0.05, S * 0.03, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();

  ctx.save();
  ctx.translate(-S * 0.30, S * 0.04);
  ctx.rotate(legR * 0.3);
  ctx.strokeStyle = suitColor;
  ctx.lineWidth = S * 0.10;
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(-S * 0.24, 0);
  ctx.stroke();
  ctx.strokeStyle = skinColor;
  ctx.lineWidth = S * 0.07;
  ctx.beginPath();
  ctx.moveTo(-S * 0.24, 0);
  ctx.lineTo(-S * 0.44, 0);
  ctx.stroke();
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.ellipse(-S * 0.47, 0, S * 0.05, S * 0.03, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();

  ctx.save();
  ctx.rotate(0.05);
  const torsoGrad = ctx.createLinearGradient(0, -S * 0.4, 0, S * 0.4);
  torsoGrad.addColorStop(0, skinColor);
  torsoGrad.addColorStop(0.5, skinColor);
  torsoGrad.addColorStop(1, suitColor);
  ctx.fillStyle = torsoGrad;
  ctx.beginPath();
  ctx.moveTo(S * 0.28, -S * 0.14);
  ctx.bezierCurveTo(S * 0.15, -S * 0.22, -S * 0.10, -S * 0.22, -S * 0.28, -S * 0.10);
  ctx.lineTo(-S * 0.28, S * 0.10);
  ctx.bezierCurveTo(-S * 0.10, S * 0.22, S * 0.15, S * 0.22, S * 0.28, S * 0.14);
  ctx.closePath();
  ctx.fill();
  ctx.restore();

  drawSwimTrunks(S, suitColor, -S * 0.22, 0, 0.05, true);

  ctx.save();
  ctx.translate(S * 0.15, -S * 0.10);
  ctx.rotate(-1.4 + strokeL * 1.4);
  drawArm(S, skinColor, suitColor, 0, 0, 0, 0.3, 0.2, false);
  ctx.restore();

  ctx.save();
  ctx.translate(S * 0.15, S * 0.10);
  ctx.rotate(1.6 + strokeR * 1.4);
  drawArm(S, skinColor, suitColor, 0, 0, 0, 0.4, 0.3, true);
  ctx.restore();

  drawHead(S, skinColor, capColor, glassColor, S * 0.30, 0, -Math.PI / 2 + 0.1, 0, true);
}

// Универсальная рука для брасса/спины
function drawArm(S, skinColor, suitColor, shoulderX, shoulderY, shoulderRot, elbowAngle, forearmAngle, isUnderwater) {
  ctx.save();
  ctx.translate(shoulderX, shoulderY);
  ctx.rotate(shoulderRot);
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.arc(0, 0, S * 0.075, 0, Math.PI * 2);
  ctx.fill();
  ctx.strokeStyle = skinColor;
  ctx.lineWidth = S * 0.075;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(S * 0.22, 0);
  ctx.stroke();
  ctx.save();
  ctx.translate(S * 0.22, 0);
  ctx.rotate(elbowAngle + forearmAngle);
  ctx.beginPath();
  ctx.moveTo(0, 0);
  ctx.lineTo(S * 0.22, 0);
  ctx.stroke();
  ctx.fillStyle = skinColor;
  ctx.beginPath();
  ctx.ellipse(S * 0.24, 0, S * 0.045, S * 0.035, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();
  ctx.restore();
}

function drawBubbles() {
  for (const b of bubbles) {
    const x = b.x - (player.x - W / 2);
    const y = b.y - (player.y - H / 2);
    if (x < -20 || x > W + 20 || y < -20 || y > H + 20) continue;
    ctx.strokeStyle = 'rgba(200, 240, 255, 0.8)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.arc(x, y, b.r, 0, Math.PI * 2);
    ctx.stroke();
    ctx.fillStyle = 'rgba(180, 230, 255, 0.3)';
    ctx.fill();
  }
}

function drawParticles() {
  for (const p of particles) {
    const x = p.x - (player.x - W / 2);
    const y = p.y - (player.y - H / 2);
    if (x < -20 || x > W + 20 || y < -20 || y > H + 20) continue;
    const a = p.lifeMax ? p.life / p.lifeMax : p.life;
    ctx.fillStyle = (p.color || 'rgba(180,230,255,') + (a * 0.7) + ')';
    ctx.beginPath();
    ctx.arc(x, y, p.size * a, 0, Math.PI * 2);
    ctx.fill();
  }
}

function drawFloatTexts() {
  for (const f of floatTexts) {
    const x = f.x - (player.x - W / 2);
    const y = f.y - (player.y - H / 2);
    ctx.save();
    ctx.globalAlpha = Math.min(1, f.life);
    ctx.fillStyle = f.color;
    ctx.font = 'bold 22px Arial';
    ctx.textAlign = 'center';
    ctx.fillText(f.text, x, y);
    ctx.restore();
  }
}

function drawUnderwaterOverlay(time) {
  const surfaceY = waveY(player.x, time);
  if (player.y <= surfaceY + 20) return;
  ctx.fillStyle = 'rgba(20, 100, 180, 0.12)';
  ctx.fillRect(0, 0, W, H);
  if (player.alive && (player.oxygen < 20 || player.health < 30 || player.poisonTime > 0) && !player.inCave) {
    const danger = Math.max(
      player.oxygen < 20 ? (1 - player.oxygen / 20) : 0,
      player.health < 30 ? (1 - player.health / 30) : 0,
      player.poisonTime > 0 ? 0.6 : 0
    );
    const pulse = 0.5 + Math.sin(time * 8) * 0.5;
    const alpha = danger * 0.35 * pulse;
    const grad = ctx.createRadialGradient(W/2, H/2, H * 0.15, W/2, H/2, H * 0.85);
    grad.addColorStop(0, 'rgba(0,0,0,0)');
    // Отравление — фиолетовый цвет, иначе красный
    const poisonColor = player.poisonTime > 0 ? '168, 85, 247' : '180, 0, 0';
    grad.addColorStop(1, `rgba(${poisonColor},${alpha})`);
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);
  }
}

function drawNightOverlay() {
  if (nightTransition < 0.02) return;
  ctx.fillStyle = `rgba(10, 20, 60, ${nightTransition * 0.35})`;
  ctx.fillRect(0, 0, W, H);
}

let lastTime = performance.now();
let time_global = 0;
let fpsFrames = 0, fpsTime = 0, fps = 60;

function loop(now) {
  requestAnimationFrame(loop);
  const dt = Math.min(0.05, (now - lastTime) / 1000);
  lastTime = now;

  fpsFrames++;
  fpsTime += dt;
  if (fpsTime >= 0.5) {
    fps = Math.round(fpsFrames / fpsTime);
    fpsFrames = 0; fpsTime = 0;
    if (saveData.settings.fps) DOM.fpsCounter.textContent = `${fps} FPS`;
  }

  if (gameState === STATE.PLAYING) {
    time_global += dt;
    stats.time = (performance.now() - stats.startTime) / 1000;
    updateTimerUI(stats.time);
    updateDayNight(dt);
    updatePlayer(dt, time_global);
    if (gameState === STATE.PLAYING) {
      updateSharks(dt);
      if (saveData.settings.creatures) updateCreatures(dt, time_global);
      if (saveData.settings.caves) updateCaveJellyfish(dt, time_global);
      updateBoats(dt);
      checkPickups();
      updateParticles(dt, time_global);
    }
  } else if (gameState === STATE.PAUSED) {
    // frozen
  } else if (gameState === STATE.DEAD || gameState === STATE.WIN) {
    time_global += dt;
    updateParticles(dt, time_global);
  } else {
    time_global += dt;
  }

  if (gameState === STATE.PLAYING || gameState === STATE.PAUSED ||
      gameState === STATE.DEAD || gameState === STATE.WIN) {
    const camX = player.x - W / 2;
    const camY = player.y - H / 2;
    drawUnderwater();
    drawFloor(time_global, camX, camY);
    drawCaves(camX, camY, time_global);
    drawDistanceMarkers(camX, camY);
    drawCoins(time_global, camX, camY);
    drawPickups(time_global, camX, camY);
    if (saveData.settings.creatures) {
      for (const c of creatures) if (c.type === 'whale') drawCreature(c, camX, camY, time_global);
    }
    for (const b of boats) drawBoat(b, camX, camY, time_global);
    drawParticles();
    drawSurface(time_global, camX, camY);
    if (saveData.settings.creatures) {
      for (const c of creatures) if (c.type !== 'whale') drawCreature(c, camX, camY, time_global);
    }
    if (saveData.settings.caves) drawCaveJellyfish(camX, camY, time_global);
    for (const sh of sharks) drawShark(sh, camX, camY);

    drawRealisticSwimmer(time_global);

    drawBubbles();
    drawFloatTexts();
    drawNightOverlay();
    drawUnderwaterOverlay(time_global);
  } else {
    const loc = LOCATIONS[selectedLocation];
    const grad = ctx.createLinearGradient(0, 0, 0, H);
    grad.addColorStop(0, `rgb(${loc.waterColor.r}, ${loc.waterColor.g}, ${loc.waterColor.b})`);
    grad.addColorStop(0.5, `rgb(${loc.waterDeep.r + 20}, ${loc.waterDeep.g + 20}, ${loc.waterDeep.b + 30})`);
    grad.addColorStop(1, '#000a14');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);
    ctx.beginPath();
    ctx.moveTo(0, H * 0.75);
    for (let x = 0; x <= W; x += 16) {
      const y = H * 0.75 + Math.sin(x * 0.02 + time_global * 1.5) * 15 + Math.sin(x * 0.008 + time_global * 0.8) * 10;
      ctx.lineTo(x, y);
    }
    ctx.lineTo(W, H); ctx.lineTo(0, H);
    ctx.closePath();
    ctx.fillStyle = 'rgba(79, 195, 247, 0.15)';
    ctx.fill();
  }
}
requestAnimationFrame(loop);

function bindToggle(id, settingKey) {
  const el = document.getElementById(id);
  const update = () => { el.classList.toggle('on', saveData.settings[settingKey]); };
  update();
  el.addEventListener('click', () => {
    saveData.settings[settingKey] = !saveData.settings[settingKey];
    update();
    persist();
    if (settingKey === 'fps') DOM.fpsCounter.classList.toggle('visible', saveData.settings.fps);
  });
}
bindToggle('toggle-fps', 'fps');
