<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Плавание — Полное меню</title>
<style>
  * { -webkit-tap-highlight-color: transparent; user-select: none; box-sizing: border-box; }
  body {
    margin: 0; overflow: hidden; background: #001a2e;
    font-family: 'Segoe UI', Arial, sans-serif; color: white; touch-action: none;
  }
  canvas { display: block; }

  #ui {
    position: absolute; top: 10px; left: 10px;
    background: rgba(0, 0, 0, 0.45); padding: 10px 14px;
    border-radius: 12px; font-size: 13px; line-height: 1.5;
    pointer-events: none; z-index: 10; min-width: 175px; display: none;
  }
  #ui.visible { display: block; }
  #ui b { color: #4fc3f7; }
  .bar-label { font-size: 12px; margin-top: 6px; }
  #oxygen-bar, #health-bar, #shield-bar, #poison-bar {
    width: 150px; height: 10px; background: rgba(255,255,255,0.15);
    border-radius: 5px; margin-top: 3px; overflow: hidden;
  }
  #oxygen-fill { height: 100%; width: 100%; background: linear-gradient(90deg, #4fc3f7, #00e5ff); }
  #health-fill { height: 100%; width: 100%; background: linear-gradient(90deg, #ff3b30, #ff6b5b); }
  #shield-bar { display: none; }
  #shield-bar.visible { display: block; }
  #shield-fill { height: 100%; width: 100%; background: linear-gradient(90deg, #b464ff, #7dd3fc); }
  #poison-bar { display: none; }
  #poison-bar.visible { display: block; }
  #poison-fill { height: 100%; width: 100%; background: linear-gradient(90deg, #a855f7, #ec4899); }
  #coin-display {
    display: flex; align-items: center; gap: 6px;
    margin-top: 8px; padding-top: 8px;
    border-top: 1px solid rgba(255,255,255,0.1);
    font-size: 16px; font-weight: bold;
  }
  #coin-display .coin-icon { font-size: 20px; }
  #coin-display .coin-count { color: #ffd700; }

  #cave-indicator {
    position: absolute; top: 60px; left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, rgba(80, 200, 255, 0.85), rgba(180, 100, 255, 0.85));
    border: 2px solid #b464ff;
    padding: 8px 20px; border-radius: 30px;
    font-size: 13px; font-weight: bold;
    color: white; letter-spacing: 1px;
    box-shadow: 0 0 25px rgba(180, 100, 255, 0.8);
    display: none; z-index: 12;
    animation: cavePulse 1.5s ease-in-out infinite;
  }
  #cave-indicator.visible { display: block; }
  @keyframes cavePulse {
    0%, 100% { transform: translateX(-50%) scale(1); box-shadow: 0 0 25px rgba(180, 100, 255, 0.6); }
    50% { transform: translateX(-50%) scale(1.05); box-shadow: 0 0 40px rgba(180, 100, 255, 1); }
  }
  #cave-indicator .cave-icon { font-size: 16px; margin-right: 4px; }

  #poison-indicator {
    position: absolute; top: 130px; left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.9), rgba(236, 72, 153, 0.9));
    border: 2px solid #ec4899;
    padding: 6px 18px; border-radius: 20px;
    font-size: 12px; font-weight: bold;
    color: white; letter-spacing: 1px;
    box-shadow: 0 0 20px rgba(236, 72, 153, 0.7);
    display: none; z-index: 12;
    animation: poisonPulse 1s ease-in-out infinite;
  }
  #poison-indicator.visible { display: block; }
  @keyframes poisonPulse {
    0%, 100% { opacity: 0.85; }
    50% { opacity: 1; }
  }

  #time-of-day {
    position: absolute; top: 10px; right: 115px;
    background: rgba(0, 0, 0, 0.55); padding: 8px 14px;
    border-radius: 12px; font-size: 14px; font-weight: bold;
    color: #ffd700; display: none; z-index: 10;
    display: flex; align-items: center; gap: 6px;
    transition: color 0.5s;
  }
  #time-of-day.visible { display: flex; }
  #time-of-day.night { color: #7dd3fc; }
  #time-of-day .tod-icon { font-size: 18px; }
  #time-of-day .tod-timer {
    font-family: 'Courier New', monospace;
    font-size: 12px;
    color: rgba(255,255,255,0.75);
  }

  #timer-panel {
    position: absolute; top: 10px; right: 60px;
    background: rgba(0, 0, 0, 0.55); padding: 8px 16px;
    border-radius: 12px; font-size: 20px; font-weight: bold;
    letter-spacing: 2px; font-family: 'Courier New', monospace;
    color: #4fc3f7; display: none; z-index: 10;
    min-width: 110px; text-align: center;
  }
  #timer-panel.visible { display: block; }
  #timer-panel .timer-label {
    font-size: 10px; color: rgba(255,255,255,0.6);
    letter-spacing: 2px; margin-bottom: 2px;
    font-family: 'Segoe UI', Arial, sans-serif;
  }
  #reward-preview {
    margin-top: 5px; padding-top: 5px;
    border-top: 1px solid rgba(255,255,255,0.15);
    font-size: 12px; font-family: 'Segoe UI', Arial, sans-serif;
    font-weight: normal;
    display: flex; align-items: center; justify-content: center; gap: 5px;
  }
  #reward-preview .medal-icon { font-size: 14px; }
  #reward-preview .coin-count { color: #ffd700; font-weight: bold; font-size: 14px; }

  #danger-indicator {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-size: 70px; pointer-events: none;
    opacity: 0; z-index: 15;
  }
  #danger-indicator.active { animation: dangerFlash 0.6s ease-in-out infinite; }
  @keyframes dangerFlash {
    0%, 100% { opacity: 0.3; transform: translate(-50%, -50%) scale(0.9); }
    50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
  }

  #buffs-panel {
    position: absolute; top: 165px; right: 10px;
    display: none; flex-direction: column; gap: 6px; z-index: 10;
  }
  #buffs-panel.visible { display: flex; }
  .buff-chip {
    display: flex; align-items: center; gap: 6px;
    background: rgba(0,0,0,0.5); padding: 6px 10px;
    border-radius: 20px; font-size: 12px;
    border: 1px solid rgba(255,255,255,0.15);
  }
  .buff-chip .icon { font-size: 16px; }
  .buff-chip .time { color: #ffd700; font-weight: bold; min-width: 26px; text-align: right; }

  #distance-panel {
    position: absolute; top: 10px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.5); padding: 10px 20px;
    border-radius: 14px; text-align: center; z-index: 10;
    min-width: 220px; display: none;
  }
  #distance-panel.visible { display: block; }
  #distance-progress-bar {
    width: 220px; height: 8px; background: rgba(255,255,255,0.15);
    border-radius: 4px; margin: 6px auto 0; overflow: hidden;
  }
  #distance-progress-fill {
    height: 100%; width: 0%;
    background: linear-gradient(90deg, #00e5ff, #7dd3fc, #b3f0ff);
    border-radius: 4px;
  }
  #distance-text { font-size: 13px; letter-spacing: 1px; font-weight: bold; }
  #distance-remaining { font-size: 11px; color: rgba(255,255,255,0.7); margin-top: 3px; }

  #finish-marker-info {
    position: absolute; top: 105px; left: 50%; transform: translateX(-50%);
    background: rgba(255, 200, 0, 0.2); border: 1px solid rgba(255, 215, 0, 0.5);
    padding: 6px 16px; border-radius: 20px; font-size: 12px; color: #ffd700;
    display: none; z-index: 10;
  }

  #menu-btn {
    position: absolute; top: 10px; right: 10px;
    width: 44px; height: 44px; border-radius: 12px;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255,255,255,0.2);
    color: white; font-size: 22px; display: none;
    align-items: center; justify-content: center;
    z-index: 30; cursor: pointer;
  }
  #menu-btn.visible { display: flex; }
  #menu-btn:active { transform: scale(0.9); background: rgba(79, 195, 247, 0.4); }

  #joystick {
    position: absolute; bottom: 30px; left: 30px;
    width: 140px; height: 140px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 2px solid rgba(255, 255, 255, 0.25);
    touch-action: none; z-index: 20; display: none;
  }
  #joystick.visible { display: block; }
  #joystick-knob {
    position: absolute; top: 50%; left: 50%;
    width: 60px; height: 60px; margin: -30px 0 0 -30px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #7dd3fc, #0284c7);
    box-shadow: 0 0 15px rgba(79, 195, 247, 0.6);
    will-change: transform;
  }

  #actions {
    position: absolute; bottom: 30px; right: 25px;
    display: none; flex-direction: column; gap: 12px;
    align-items: center; z-index: 20;
  }
  #actions.visible { display: flex; }
  .btn {
    width: 75px; height: 75px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.3);
    color: white; font-size: 26px;
    display: flex; align-items: center; justify-content: center;
    touch-action: none; font-weight: bold;
  }
  .btn:active, .btn.active { background: rgba(79, 195, 247, 0.5); transform: scale(0.92); }
  #btn-boost {
    width: 95px; height: 95px;
    background: rgba(255, 59, 48, 0.25);
    border-color: rgba(255, 100, 90, 0.5);
    font-size: 32px;
  }
  .btn-label {
    position: absolute; bottom: -18px;
    font-size: 10px; color: rgba(255,255,255,0.7);
  }

  .overlay {
    position: absolute; inset: 0; z-index: 100;
    display: none; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center; padding: 20px; overflow-y: auto;
  }
  .overlay.show { display: flex; }

  #menu {
    background: linear-gradient(180deg, #0a2a4a 0%, #001828 60%, #000a14 100%);
    padding: 0;
    align-items: stretch;
    justify-content: flex-start;
  }

  .menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: rgba(0, 0, 0, 0.4);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    flex-shrink: 0;
  }
  .menu-header .logo {
    display: flex; align-items: center; gap: 8px;
    font-size: 16px; font-weight: 900; letter-spacing: 2px;
    background: linear-gradient(90deg, #4fc3f7, #00e5ff);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }
  .menu-header .logo .logo-icon { font-size: 24px; }
  .menu-coins-mini {
    display: flex; align-items: center; gap: 6px;
    background: linear-gradient(135deg, rgba(255, 215, 0, 0.15), rgba(255, 200, 0, 0.08));
    border: 1px solid rgba(255, 215, 0, 0.4);
    padding: 6px 14px; border-radius: 20px;
    font-size: 15px; font-weight: bold;
  }
  .menu-coins-mini .coin-icon { font-size: 18px; }
  .menu-coins-mini .coin-count { color: #ffd700; }

  .menu-tabs {
    display: flex; gap: 4px;
    padding: 8px 12px;
    background: rgba(0, 0, 0, 0.3);
    overflow-x: auto;
    flex-shrink: 0;
    scrollbar-width: none;
  }
  .menu-tabs::-webkit-scrollbar { display: none; }
  .tab-btn {
    padding: 8px 14px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    color: rgba(255,255,255,0.7);
    font-size: 12px; font-weight: bold;
    letter-spacing: 0.5px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s;
    font-family: inherit;
  }
  .tab-btn.active {
    background: linear-gradient(135deg, rgba(0, 229, 255, 0.3), rgba(79, 195, 247, 0.2));
    border-color: #00e5ff;
    color: white;
    box-shadow: 0 0 12px rgba(0, 229, 255, 0.4);
  }
  .tab-btn:active { transform: scale(0.95); }

  .menu-content {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    scrollbar-width: thin;
    scrollbar-color: rgba(79, 195, 247, 0.4) transparent;
  }
  .menu-content::-webkit-scrollbar { width: 6px; }
  .menu-content::-webkit-scrollbar-thumb {
    background: rgba(79, 195, 247, 0.4);
    border-radius: 3px;
  }

  .tab-panel {
    display: none;
    animation: fadeInPanel 0.25s ease;
  }
  .tab-panel.active { display: block; }
  @keyframes fadeInPanel {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .menu-section-title {
    font-size: 12px; letter-spacing: 2px;
    color: rgba(79, 195, 247, 0.9);
    margin-bottom: 12px;
    text-transform: uppercase; font-weight: bold;
    text-align: left;
    display: flex; align-items: center; gap: 6px;
  }
  .menu-section-title::before {
    content: ''; display: inline-block;
    width: 3px; height: 14px;
    background: linear-gradient(180deg, #00e5ff, #4fc3f7);
    border-radius: 2px;
  }

  .hero-card {
    background: linear-gradient(135deg, rgba(79, 195, 247, 0.2), rgba(0, 229, 255, 0.1));
    border: 1px solid rgba(79, 195, 247, 0.4);
    border-radius: 20px;
    padding: 20px;
    margin-bottom: 16px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero-card::before {
    content: ''; position: absolute;
    top: -50%; right: -20%;
    width: 200px; height: 200px;
    background: radial-gradient(circle, rgba(0, 229, 255, 0.3), transparent 70%);
    border-radius: 50%;
  }
  .hero-emoji { font-size: 56px; margin-bottom: 8px; animation: bob 2s ease-in-out infinite; }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  .hero-title {
    font-size: 28px; font-weight: 900; letter-spacing: 2px;
    background: linear-gradient(90deg, #4fc3f7, #00e5ff, #7dd3fc);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    margin-bottom: 6px;
  }
  .hero-subtitle {
    font-size: 11px; color: rgba(255,255,255,0.6);
    letter-spacing: 3px; text-transform: uppercase;
    margin-bottom: 16px;
  }

  .selected-config {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-bottom: 16px;
  }
  .config-item {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 10px 8px;
    text-align: center;
  }
  .config-item .ci-icon { font-size: 22px; display: block; margin-bottom: 4px; }
  .config-item .ci-label {
    font-size: 9px; color: rgba(255,255,255,0.5);
    letter-spacing: 1px; text-transform: uppercase;
    display: block;
  }
  .config-item .ci-value {
    font-size: 12px; font-weight: bold; color: #4fc3f7;
    display: block; margin-top: 2px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 16px;
  }
  .stat-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    padding: 14px;
    text-align: left;
  }
  .stat-card .stat-icon { font-size: 24px; margin-bottom: 6px; }
  .stat-card .stat-label {
    font-size: 10px; color: rgba(255,255,255,0.5);
    letter-spacing: 1px; text-transform: uppercase;
    margin-bottom: 4px;
  }
  .stat-card .stat-value { font-size: 20px; font-weight: 900; color: #4fc3f7; }
  .stat-card .stat-value.gold { color: #ffd700; }

  .start-btn {
    display: block;
    width: 100%;
    padding: 20px;
    font-size: 18px; font-weight: 900;
    letter-spacing: 3px;
    background: linear-gradient(135deg, #0a84ff, #00e5ff);
    border: none; border-radius: 50px;
    color: white; cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s;
    touch-action: manipulation;
    font-family: inherit;
    box-shadow: 0 8px 30px rgba(10, 132, 255, 0.5);
    margin-top: 8px;
  }
  .start-btn:active { transform: scale(0.97); }

  #locations {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 10px;
  }
  .loc-btn {
    background: rgba(255,255,255,0.06);
    border: 2px solid rgba(255,255,255,0.15);
    border-radius: 14px;
    padding: 12px 8px;
    color: white; cursor: pointer;
    transition: all 0.15s;
    touch-action: manipulation;
    font-family: inherit;
    text-align: center;
  }
  .loc-btn:active { transform: translateY(-2px); }
  .loc-btn.selected { border-color: #00e5ff; box-shadow: 0 0 16px rgba(0,229,255,0.3); }
  .loc-btn .loc-emoji { font-size: 26px; display: block; margin-bottom: 4px; }
  .loc-btn .loc-name { font-size: 12px; font-weight: bold; display: block; }
  .loc-btn .loc-desc { font-size: 9px; color: rgba(255,255,255,0.5); display: block; margin-top: 3px; }
  .loc-btn .loc-danger { font-size: 9px; color: #ff6b5b; margin-top: 3px; display: block; }
  .loc-btn .loc-cave { font-size: 9px; color: #b464ff; margin-top: 3px; display: block; }

  #suits {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 10px;
  }
  .suit-card {
    background: rgba(255,255,255,0.05);
    border: 2px solid rgba(255,255,255,0.15);
    border-radius: 14px; padding: 12px 8px;
    cursor: pointer; transition: all 0.15s;
    touch-action: manipulation; font-family: inherit; color: white;
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; align-items: center;
  }
  .suit-card:active { transform: scale(0.96); }
  .suit-card.selected {
    border-color: #00e5ff;
    background: linear-gradient(135deg, rgba(0, 229, 255, 0.15), rgba(79, 195, 247, 0.08));
    box-shadow: 0 0 16px rgba(0, 229, 255, 0.4);
  }
  .suit-card.locked { opacity: 0.7; }
  .suit-card.selected::after {
    content: '✓'; position: absolute; top: 6px; right: 8px;
    color: #00e5ff; font-weight: 900; font-size: 16px;
  }
  .suit-preview {
    width: 60px; height: 60px;
    border-radius: 50%;
    margin-bottom: 6px;
    display: flex; align-items: center; justify-content: center;
    font-size: 34px;
    position: relative;
  }
  .suit-preview::after {
    content: ''; position: absolute; inset: 0;
    border-radius: 50%; border: 2px solid rgba(255,255,255,0.3);
  }
  .suit-name { font-size: 12px; font-weight: bold; margin-bottom: 4px; }
  .suit-price {
    font-size: 11px; font-weight: bold;
    color: #ffd700;
    display: flex; align-items: center; gap: 3px;
  }
  .suit-price.owned-tag { color: #4ade80; }
  .suit-price.equipped { color: #00e5ff; }
  .suit-stats { font-size: 9px; color: rgba(255,255,255,0.55); margin-top: 4px; text-align: center; }
  .suit-stats .stat-up { color: #4ade80; }

  #swimmers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 12px;
  }
  .swimmer-card {
    background: rgba(255,255,255,0.05);
    border: 2px solid rgba(255,255,255,0.15);
    border-radius: 16px; padding: 14px 10px;
    cursor: pointer; transition: all 0.15s;
    touch-action: manipulation; font-family: inherit; color: white;
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; align-items: center;
    text-align: center;
  }
  .swimmer-card:active { transform: scale(0.97); }
  .swimmer-card.selected {
    border-color: #ffd700;
    background: linear-gradient(135deg, rgba(255, 215, 0, 0.18), rgba(255, 200, 0, 0.06));
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.5);
  }
  .swimmer-card.selected::after {
    content: '⭐'; position: absolute; top: 8px; right: 10px;
    font-size: 18px;
  }
  .swimmer-card.locked { opacity: 0.85; }
  .swimmer-card.legendary {
    background: linear-gradient(135deg, rgba(255, 215, 0, 0.12), rgba(180, 100, 255, 0.08));
    border-color: rgba(255, 215, 0, 0.5);
  }

  .swimmer-avatar {
    width: 72px; height: 72px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 42px;
    border: 3px solid rgba(255,255,255,0.4);
    margin-bottom: 8px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.4);
    position: relative;
    overflow: hidden;
  }
  .swimmer-avatar::after {
    content: '';
    position: absolute;
    bottom: -20%; left: -10%; right: -10%;
    height: 40%;
    background: rgba(255,255,255,0.18);
    border-radius: 50%;
    filter: blur(6px);
  }
  .swimmer-avatar .emoji {
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
  }

  .swimmer-name { font-size: 12px; font-weight: bold; margin-bottom: 2px; line-height: 1.2; }
  .swimmer-country { font-size: 10px; color: rgba(255,255,255,0.6); margin-bottom: 8px; }

  .swimmer-bars {
    width: 100%;
    display: flex; flex-direction: column; gap: 4px;
    margin-bottom: 8px;
  }
  .swimmer-bar-row {
    display: flex; align-items: center; gap: 5px;
    font-size: 9px;
  }
  .swimmer-bar-row .bar-lbl {
    width: 48px; color: rgba(255,255,255,0.6); text-align: left;
    font-size: 8px;
  }
  .swimmer-bar {
    flex: 1; height: 6px;
    background: rgba(255,255,255,0.12);
    border-radius: 3px;
    overflow: hidden;
