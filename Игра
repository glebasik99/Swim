function winGame() {
  if (gameState !== STATE.PLAYING) return;
  if (!player.alive) return;
  player.alive = false;
  gameState = STATE.WIN;
  input.joyX = 0; input.joyY = 0;
  input.boost = false; input.up = false; input.down = false;
  joyActive = false; joyId = null;
  if (knob) knob.style.transform = 'translate(0, 0)';
  document.querySelectorAll('.btn').forEach(b => b.classList.remove('active'));
  DOM.damageOverlay.style.opacity = '0';
  DOM.dangerIndicator.style.opacity = '0';
  DOM.dangerIndicator.classList.remove('active');
  DOM.finishInfo.style.display = 'none';
  DOM.caveIndicator.classList.remove('visible');
  DOM.poisonIndicator.classList.remove('visible');
  DOM.poisonOverlay.style.opacity = '0';
  hideHUD();

  saveData.totalSwims = (saveData.totalSwims || 0) + 1;
  const elapsed = stats.time;
  const reward = getReward(selectedDistance, elapsed);
  const loc = LOCATIONS[selectedLocation];
  const locMult = 1 + loc.sharkCount * 0.05;
  const finalReward = Math.floor(reward.reward * locMult);
  saveData.coins += finalReward;

  const rec = saveData.records[selectedDistance];
  let isRecord = false;
  if (!rec || elapsed < rec) { saveData.records[selectedDistance] = elapsed; isRecord = true; }
  persist();

  DOM.ffMedal.textContent = reward.medal;
  DOM.ffTitle.textContent = 'ФИНИШ!';
  DOM.ffTime.textContent = formatTimeMS(elapsed);
  DOM.ffReward.textContent = `+${finalReward}`;
  DOM.ffRecord.style.display = isRecord ? 'block' : 'none';
  DOM.finishFlash.classList.add('show');

  const bg = DOM.finishFlash.querySelector('.ff-bg');
  const content = DOM.finishFlash.querySelector('.ff-content');
  bg.style.animation = 'none'; content.style.animation = 'none';
  void bg.offsetWidth; void content.offsetWidth;
  bg.style.animation = ''; content.style.animation = '';

  setTimeout(() => { DOM.finishFlash.classList.remove('show'); instantToMenu(); }, 1400);
}

function updateParticles(dt, time) {
  for (let i = bubbles.length - 1; i >= 0; i--) {
    const b = bubbles[i];
    b.wobble += dt * 4;
    b.x += (b.vx + Math.sin(b.wobble) * 0.5) * dt * 30;
    b.y += b.vy * dt * 30;
    if (b.y < waveY(b.x, time)) { bubbles.splice(i, 1); continue; }
    b.vy -= 20 * dt;
    b.vx *= Math.pow(0.5, dt * 2);
  }
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx * dt; p.y += p.vy * dt;
    p.vx *= Math.pow(0.5, dt * 3); p.vy *= Math.pow(0.5, dt * 3);
    p.life -= dt * 1.5;
    if (p.life <= 0) particles.splice(i, 1);
  }
  for (let i = floatTexts.length - 1; i >= 0; i--) {
    const f = floatTexts[i];
    f.y += f.vy * dt; f.vy *= Math.pow(0.5, dt * 2);
    f.life -= dt;
    if (f.life <= 0) floatTexts.splice(i, 1);
  }
}

