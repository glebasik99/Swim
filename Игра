function applyPoison(damage, poisonTime) {
  // Мгновенный урон от медузы
  player.health -= damage;
  // Устанавливаем время отравления
  player.poisonTime = Math.max(player.poisonTime, poisonTime);
  player.poison = Math.min(player.maxPoison, player.poison + 40);
  
  // Показываем индикатор
  DOM.poisonIndicator.classList.add('visible');
  DOM.poisonOverlay.style.opacity = '0.6';
  DOM.poisonBar.classList.add('visible');
  DOM.poisonLabel.style.display = 'block';
  
  addFloatText(player.x, player.y - 45, '☠️ ОТРАВЛЕН!', '#a855f7');
  
  if (player.health <= 0) { player.health = 0; die('кислород'); }
}

function updatePoison(dt) {
  if (player.poisonTime > 0) {
    // Тикающий урон
    player.poisonTime -= dt;
    player.health -= 6 * dt; // 6 HP в секунду
    player.poison = Math.max(0, player.poison - 20 * dt);
    
    // Периодические частицы отравления
    if (Math.random() < 0.15) {
      spawnParticle(player.x + (Math.random()-0.5)*40, player.y + (Math.random()-0.5)*40,
        (Math.random()-0.5)*30, -20-Math.random()*30, 'rgba(168,85,247,', 1);
    }
    
    // Обновляем UI
    DOM.poisonFill.style.width = (player.poison / player.maxPoison * 100) + '%';
    
    if (player.health <= 0) { player.health = 0; die('кислород'); }
  } else {
    // Плавно снимаем индикатор
    if (player.poison > 0) {
      player.poison = Math.max(0, player.poison - 30 * dt);
    } else {
      DOM.poisonIndicator.classList.remove('visible');
      DOM.poisonOverlay.style.opacity = '0';
      DOM.poisonBar.classList.remove('visible');
      DOM.poisonLabel.style.display = 'none';
    }
  }
}

function updateDayNight(dt) {
  dayNightTimer += dt;
  const phaseDuration = isNight ? NIGHT_DURATION : DAY_DURATION;
  if (dayNightTimer >= phaseDuration) {
    dayNightTimer = 0;
    isNight = !isNight;
    if (isNight && !nightVisitRecorded) {
      saveData.nightVisits = (saveData.nightVisits || 0) + 1;
      nightVisitRecorded = true;
      persist();
      setTimeout(() => { nightVisitRecorded = false; }, 5000);
    }
    addFloatText(player.x, player.y - 80, isNight ? '🌙 НАСТУПИЛА НОЧЬ' : '☀️ НАСТУПИЛ ДЕНЬ', isNight ? '#7dd3fc' : '#ffd700');
  }
  const targetTransition = isNight ? 1 : 0;
  nightTransition += (targetTransition - nightTransition) * dt * 0.8;

  const timeLeft = Math.max(0, phaseDuration - dayNightTimer);
  const min = Math.floor(timeLeft / 60);
  const sec = Math.floor(timeLeft % 60);
  DOM.todTimer.textContent = `${min}:${String(sec).padStart(2,'0')}`;
  if (isNight) {
    DOM.todIcon.textContent = '🌙';
    DOM.todLabel.textContent = 'Ночь';
    DOM.timeOfDay.classList.add('night');
  } else {
    DOM.todIcon.textContent = '☀️';
    DOM.todLabel.textContent = 'День';
    DOM.timeOfDay.classList.remove('night');
  }
}

