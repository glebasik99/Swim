let joyActive = false, joyId = null;
let joyCenter = { x:0, y:0 }, joyRadius = 60;

function getJoyCenter() {
  const r = joystick.getBoundingClientRect();
  joyCenter.x = r.left + r.width / 2;
  joyCenter.y = r.top + r.height / 2;
  joyRadius = r.width / 2 - 20;
}
getJoyCenter();
window.addEventListener('resize', getJoyCenter);
