function handleJoyStart(e) {
  if (gameState !== STATE.PLAYING) return;
  e.preventDefault();
  const t = e.changedTouches ? e.changedTouches[0] : e;
  joyId = t.identifier !== undefined ? t.identifier : 'mouse';
  joyActive = true; getJoyCenter(); handleJoyMove(e);
}
function handleJoyMove(e) {
  if (!joyActive) return;
  e.preventDefault();
  const touches = e.changedTouches ? e.changedTouches : [e];
  for (const t of touches) {
    const id = t.identifier !== undefined ? t.identifier : 'mouse';
    if (id !== joyId) continue;
    let dx = t.clientX - joyCenter.x;
    let dy = t.clientY - joyCenter.y;
    const dist = Math.hypot(dx, dy);
    if (dist > joyRadius) { dx = dx / dist * joyRadius; dy = dy / dist * joyRadius; }
    knob.style.transform = `translate(${dx}px, ${dy}px)`;
    input.joyX = dx / joyRadius;
    input.joyY = dy / joyRadius;
  }
}
function handleJoyEnd(e) {
  const touches = e.changedTouches ? e.changedTouches : [e];
  for (const t of touches) {
    const id = t.identifier !== undefined ? t.identifier : 'mouse';
    if (id === joyId) {
      joyActive = false; joyId = null;
      knob.style.transform = 'translate(0, 0)';
      input.joyX = 0; input.joyY = 0;
    }
  }
}
joystick.addEventListener('touchstart', handleJoyStart, { passive: false });
joystick.addEventListener('touchmove', handleJoyMove, { passive: false });
joystick.addEventListener('touchend', handleJoyEnd);
joystick.addEventListener('touchcancel', handleJoyEnd);
joystick.addEventListener('mousedown', handleJoyStart);
window.addEventListener('mousemove', handleJoyMove);
window.addEventListener('mouseup', handleJoyEnd);

function bindButton(id, prop) {
  const el = document.getElementById(id);
  const on = (e) => { e.preventDefault(); input[prop] = true; el.classList.add('active'); };
  const off = (e) => { if (e) e.preventDefault(); input[prop] = false; el.classList.remove('active'); };
  el.addEventListener('touchstart', on, { passive: false });
  el.addEventListener('touchend', off);
  el.addEventListener('touchcancel', off);
  el.addEventListener('mousedown', on);
  el.addEventListener('mouseup', off);
  el.addEventListener('mouseleave', off);
}
