function getReward(distance, timeSec) {
  const tiers = REWARD_TIERS[distance];
  if (!tiers) return { reward:10, medal:'💪', tier:4 };
  for (let i = 0; i < tiers.length; i++) {
    if (timeSec <= tiers[i].time) return { ...tiers[i], tier:i };
  }
  return { ...tiers[tiers.length-1], tier:tiers.length-1 };
}

